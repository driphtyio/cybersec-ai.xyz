---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { getCollection } from 'astro:content';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const allPosts = await getCollection('blog');
allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const latest = allPosts[0];
const remaining = allPosts.slice(1);

const aiTools = allPosts.filter(p => p.data.tags?.some(t => /ai/i.test(t)));
const tutorialCount = allPosts.filter(p => p.data.tags?.some(t => /tutorial|guide|how.to/i.test(t))).length;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Header />

    <main>
      <!-- ─── Hero ─── -->
      <section class="hero">
        <h1>No-code tools,<br/><span class="hl">tested in the real world</span></h1>
        <p class="hero-sub">Hands-on reviews of n8n, Make, Zapier, and AI agent platforms — no fluff, no affiliate bias. Just what works.</p>
        <div class="hero-ctas">
          <a href="/blog" class="btn btn-primary">Browse reviews →</a>
          <a href="/blog/tutorial" class="btn btn-secondary">Start a tutorial →</a>
        </div>
      </section>

      <!-- ─── Stats ─── -->
      <section class="stats">
        <div class="stat-card">
          <span class="stat-num">{allPosts.length}</span>
          <span class="stat-label">Reviews & guides</span>
        </div>
        <div class="stat-card">
          <span class="stat-num">{aiTools.length}</span>
          <span class="stat-label">AI tools covered</span>
        </div>
        <div class="stat-card">
          <span class="stat-num">{tutorialCount || '8'}+</span>
          <span class="stat-label">Step-by-step tutorials</span>
        </div>
        <div class="stat-card">
          <span class="stat-num">Free</span>
          <span class="stat-label">Always, no paywall</span>
        </div>
      </section>

      <!-- ─── What we cover ─── -->
      <section class="products">
        <h2 class="section-title">What we cover</h2>
        <div class="product-grid">
          <div class="product-card">
            <span class="product-icon">🔧</span>
            <h3>Tool reviews</h3>
            <p>Deep-dive reviews of no-code and low-code platforms — pricing, limits, real performance under production loads.</p>
            <a href="/blog" class="product-cta">See reviews →</a>
          </div>
          <div class="product-card">
            <span class="product-icon">🧩</span>
            <h3>Workflow tutorials</h3>
            <p>Step-by-step builds for real workflows: customer support, finance ops, sales automation, data pipelines.</p>
            <a href="/blog" class="product-cta">Start building →</a>
          </div>
          <div class="product-card">
            <span class="product-icon">🤖</span>
            <h3>AI agents & automation</h3>
            <p>AI agent frameworks, RAG pipelines, and LLM-powered automation — practical, vendor-neutral, benchmarked.</p>
            <a href="/blog" class="product-cta">Explore AI →</a>
          </div>
        </div>
      </section>

      <!-- ─── How it works ─── -->
      <section class="steps">
        <h2 class="section-title">How we review</h2>
        <div class="step-row">
          <div class="step">
            <span class="step-badge">1</span>
            <h3>Pick a tool</h3>
            <p>We select tools based on reader requests and market relevance — not sponsorships.</p>
          </div>
          <div class="step-arrow">→</div>
          <div class="step">
            <span class="step-badge">2</span>
            <h3>Test it</h3>
            <p>Every tool gets a full hands-on trial: setup, core features, edge cases, and real output quality.</p>
          </div>
          <div class="step-arrow">→</div>
          <div class="step">
            <span class="step-badge">3</span>
            <h3>Honest verdict</h3>
            <p>No affiliate bias. We publish what we found — strengths, dealbreakers, and who it's actually for.</p>
          </div>
        </div>
      </section>

      <!-- ─── Latest posts ─── -->
      <section class="blog-section">
        <h2 class="section-title">Latest</h2>
        {latest && (
          <a href={`/blog/${latest.id}/`} class="featured-card">
            <div class="fcard-overlay">
              <div class="fcard-meta">
                <time datetime={latest.data.pubDate.toISOString()}>
                  {latest.data.pubDate.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}
                </time>
                {latest.data.tags?.slice(0, 2).map(t => <span class="fcard-tag">{t}</span>)}
              </div>
              <h3 class="fcard-title">{latest.data.title}</h3>
              <p class="fcard-desc">{latest.data.description}</p>
            </div>
            {latest.data.heroImage && <img src={latest.data.heroImage} alt="" class="fcard-bg" />}
          </a>
        )}
        <div class="post-grid">
          {remaining.slice(0, 6).map((post, i) => (
            <article class="post-card">
              <a href={`/blog/${post.id}/`} class="post-card-link">
                {post.data.heroImage && (
                  <div class="pcard-img-wrap">
                    <img src={post.data.heroImage} alt="" class="pcard-img" loading={i < 3 ? 'eager' : 'lazy'} />
                  </div>
                )}
                <div class="pcard-body">
                  <div class="pcard-meta">
                    <time datetime={post.data.pubDate.toISOString()}>
                      {post.data.pubDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
                    </time>
                    {post.data.tags?.slice(0, 1).map(t => <span class="pcard-tag">{t}</span>)}
                  </div>
                  <h3 class="pcard-title">{post.data.title}</h3>
                  <p class="pcard-desc">{post.data.description}</p>
                </div>
              </a>
            </article>
          ))}
        </div>
        <div class="more-wrap">
          <a href="/blog" class="btn btn-secondary">Browse all posts →</a>
        </div>
      </section>

      <!-- ─── CTA ─── -->
      <section class="cta-section">
        <div class="cta-card">
          <h2>Get the insider view</h2>
          <p>Hands-on no-code reviews delivered to your inbox. No spam, just tools that work.</p>
          <a href="/blog" class="btn btn-primary">Start reading →</a>
        </div>
      </section>
    </main>

    <Footer />
  </body>
</html>

<style is:global>
  /* ─── Layout ─── */
  main {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 1.5em 4em;
  }
  .section-title {
    font-size: 1.3em;
    font-weight: 700;
    color: #f0f6fc;
    margin: 0 0 1.5em;
    letter-spacing: -0.01em;
  }

  /* ─── Hero ─── */
  .hero {
    text-align: center;
    padding: 4em 0 3em;
  }
  .hero h1 {
    font-size: clamp(1.8em, 5vw, 2.8em);
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.03em;
    color: #f0f6fc;
    margin: 0 0 0.6em;
  }
  .hl {
    background: linear-gradient(135deg, #22c55e, #16a34a);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  .hero-sub {
    font-size: 1.05em;
    color: rgb(var(--gray));
    max-width: 580px;
    margin: 0 auto 2em;
    line-height: 1.6;
  }
  .hero-ctas {
    display: flex;
    gap: 0.8em;
    justify-content: center;
    flex-wrap: wrap;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    padding: 0.75em 1.6em;
    font-size: 0.92em;
    font-weight: 550;
    border-radius: 10px;
    text-decoration: none;
    transition: all 0.2s;
  }
  .btn-primary {
    background: var(--accent);
    color: #0a0a0f;
  }
  .btn-primary:hover {
    background: #16a34a;
    transform: translateY(-2px);
  }
  .btn-secondary {
    background: transparent;
    color: #f0f6fc;
    border: 1px solid var(--border-light);
  }
  .btn-secondary:hover {
    border-color: var(--accent);
    color: var(--accent);
    transform: translateY(-2px);
  }

  /* ─── Stats ─── */
  .stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1em;
    margin-bottom: 4em;
  }
  .stat-card {
    background: var(--bg-card);
    border: 1px solid var(--border-light);
    border-radius: 12px;
    padding: 1.5em 1em;
    text-align: center;
    transition: border-color 0.25s, transform 0.25s;
  }
  .stat-card:hover {
    border-color: var(--accent);
    transform: translateY(-3px);
  }
  .stat-num {
    display: block;
    font-size: 1.65em;
    font-weight: 700;
    color: var(--accent);
    margin-bottom: 0.2em;
  }
  .stat-label {
    font-size: 0.82em;
    color: rgb(var(--gray));
  }

  /* ─── Product cards ─── */
  .products { margin-bottom: 4em; }
  .product-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.2em;
  }
  .product-card {
    background: var(--bg-card);
    border: 1px solid var(--border-light);
    border-radius: 14px;
    padding: 2em;
    transition: border-color 0.3s, transform 0.3s, box-shadow 0.3s;
  }
  .product-card:hover {
    border-color: var(--accent);
    transform: translateY(-4px);
    box-shadow: 0 8px 24px rgba(0,0,0,0.25);
  }
  .product-icon {
    font-size: 1.8em;
    display: block;
    margin-bottom: 0.6em;
  }
  .product-card h3 {
    font-size: 1.1em;
    font-weight: 650;
    color: #f0f6fc;
    margin: 0 0 0.5em;
  }
  .product-card p {
    font-size: 0.88em;
    color: rgb(var(--gray));
    line-height: 1.55;
    margin: 0 0 1.2em;
  }
  .product-cta {
    font-size: 0.85em;
    font-weight: 550;
    color: var(--accent);
    text-decoration: none;
    transition: gap 0.2s;
    display: inline-flex;
    align-items: center;
    gap: 0.3em;
  }
  .product-cta:hover { gap: 0.5em; }

  /* ─── Steps ─── */
  .steps { margin-bottom: 4em; }
  .step-row {
    display: grid;
    grid-template-columns: 1fr auto 1fr auto 1fr;
    align-items: start;
    gap: 0;
  }
  .step { text-align: center; }
  .step-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.2em;
    height: 2.2em;
    border-radius: 50%;
    background: rgba(34,197,94,0.12);
    color: var(--accent);
    font-weight: 700;
    font-size: 1em;
    margin-bottom: 0.6em;
  }
  .step h3 {
    font-size: 1em;
    font-weight: 650;
    color: #f0f6fc;
    margin: 0 0 0.4em;
  }
  .step p {
    font-size: 0.84em;
    color: rgb(var(--gray));
    line-height: 1.5;
    margin: 0 auto;
    max-width: 260px;
  }
  .step-arrow {
    color: rgb(var(--gray));
    font-size: 1.3em;
    padding: 1.2em 0.5em 0;
    opacity: 0.5;
  }

  /* ─── Blog feed ─── */
  .blog-section { margin-bottom: 4em; }
  .featured-card {
    position: relative;
    display: block;
    border-radius: 16px;
    overflow: hidden;
    margin-bottom: 1.5em;
    text-decoration: none;
    min-height: 280px;
    background: var(--bg-card);
    border: 1px solid var(--border-light);
    transition: border-color 0.3s, box-shadow 0.3s;
  }
  .featured-card:hover {
    border-color: var(--accent);
    box-shadow: 0 8px 24px rgba(0,0,0,0.3);
  }
  .fcard-overlay {
    position: relative;
    z-index: 2;
    padding: 2em;
    background: linear-gradient(to top, rgba(13,13,18,0.95) 0%, rgba(13,13,18,0.5) 60%, transparent 100%);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    min-height: 280px;
  }
  .fcard-bg {
    position: absolute;
    top: 0; left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 1;
  }
  .fcard-meta {
    display: flex;
    align-items: center;
    gap: 0.6em;
    font-size: 0.78em;
    color: rgb(var(--gray));
    margin-bottom: 0.6em;
  }
  .fcard-tag {
    font-size: 0.7em;
    font-weight: 500;
    color: var(--accent);
    background: rgba(34,197,94,0.08);
    border: 1px solid rgba(34,197,94,0.15);
    padding: 0.15em 0.55em;
    border-radius: 100px;
  }
  .fcard-title {
    font-size: 1.3em;
    font-weight: 700;
    color: #f0f6fc;
    margin: 0 0 0.4em;
    max-width: 600px;
  }
  .fcard-desc {
    font-size: 0.88em;
    color: rgb(var(--gray));
    line-height: 1.5;
    margin: 0;
    max-width: 550px;
  }
  .post-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.2em;
    margin-bottom: 1.5em;
  }
  .post-card {
    background: var(--bg-card);
    border: 1px solid var(--border-light);
    border-radius: 14px;
    overflow: hidden;
    transition: border-color 0.3s, transform 0.3s, box-shadow 0.3s;
  }
  .post-card:hover {
    border-color: var(--accent);
    transform: translateY(-4px);
    box-shadow: 0 8px 24px rgba(0,0,0,0.25);
  }
  .post-card-link {
    text-decoration: none;
    display: block;
  }
  .pcard-img-wrap {
    overflow: hidden;
  }
  .pcard-img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    display: block;
    transition: transform 0.3s;
  }
  .post-card:hover .pcard-img { transform: scale(1.05); }
  .pcard-body {
    padding: 1.2em 1.2em 1.5em;
  }
  .pcard-meta {
    display: flex;
    align-items: center;
    gap: 0.5em;
    font-size: 0.72em;
    color: rgb(var(--gray));
    margin-bottom: 0.5em;
  }
  .pcard-tag {
    font-size: 0.68em;
    font-weight: 500;
    color: var(--accent);
    background: rgba(34,197,94,0.08);
    border: 1px solid rgba(34,197,94,0.15);
    padding: 0.1em 0.5em;
    border-radius: 100px;
  }
  .pcard-title {
    font-size: 1em;
    font-weight: 650;
    color: #f0f6fc;
    margin: 0 0 0.35em;
    line-height: 1.3;
  }
  .post-card:hover .pcard-title { color: var(--accent); }
  .pcard-desc {
    font-size: 0.82em;
    color: rgb(var(--gray));
    line-height: 1.45;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .more-wrap {
    text-align: center;
  }

  /* ─── CTA ─── */
  .cta-section { margin-bottom: 4em; }
  .cta-card {
    background: linear-gradient(135deg, rgba(34,197,94,0.08) 0%, rgba(22,163,74,0.04) 100%);
    border: 1px solid rgba(34,197,94,0.15);
    border-radius: 18px;
    padding: 3em 2em;
    text-align: center;
  }
  .cta-card h2 {
    font-size: 1.4em;
    font-weight: 700;
    color: #f0f6fc;
    margin: 0 0 0.5em;
  }
  .cta-card p {
    font-size: 0.95em;
    color: rgb(var(--gray));
    max-width: 450px;
    margin: 0 auto 1.5em;
    line-height: 1.55;
  }

  /* ─── Responsive ─── */
  @media (max-width: 768px) {
    .hero { padding: 2.5em 0 2em; }
    .stats { grid-template-columns: repeat(2, 1fr); gap: 0.8em; }
    .product-grid { grid-template-columns: 1fr; }
    .step-row { grid-template-columns: 1fr; gap: 1.5em; text-align: center; }
    .step-arrow { display: none; }
    .step p { max-width: 100%; }
    .post-grid { grid-template-columns: 1fr; }
    .fcard-overlay { min-height: 220px; padding: 1.5em; }
    .fcard-title { font-size: 1.1em; }
  }
  @media (max-width: 480px) {
    .stats { grid-template-columns: repeat(2, 1fr); gap: 0.6em; }
    .stat-card { padding: 1em 0.6em; }
    .stat-num { font-size: 1.3em; }
    .hero h1 { font-size: clamp(1.5em, 7vw, 1.8em); }
    .hero-sub { font-size: 0.95em; }
    .btn { padding: 0.65em 1.2em; font-size: 0.85em; }
    .product-card { padding: 1.5em; }
    .cta-card { padding: 2em 1.2em; }
  }
</style>
