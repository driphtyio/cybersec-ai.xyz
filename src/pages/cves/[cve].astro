---
import type { GetStaticPathsResult } from 'astro';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import cvesData from '../../data/cves.json';

export async function getStaticPaths(): Promise<GetStaticPathsResult> {
  const cves = cvesData.cves || [];
  return cves.map((cve: any) => ({
    params: { cve: cve.id },
    props: cve,
  }));
}

const cve = Astro.props;
const date = cve.published ? new Date(cve.published).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) : 'Unknown';
const modDate = cve.lastModified ? new Date(cve.lastModified).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) : null;

function severityClass(s: string) {
  return (s || '').toLowerCase();
}
function sevColor(s: string) {
  const c = severityClass(s);
  if (c === 'critical') return '#ef4444';
  if (c === 'high') return '#f97316';
  if (c === 'medium') return '#eab308';
  return '#6b7280';
}
function sevVal(cvss: number) {
  if (cvss >= 9) return 'critical';
  if (cvss >= 7) return 'high';
  if (cvss >= 4) return 'medium';
  return 'low';
}
function emoji(s: string) {
  const c = severityClass(s);
  if (c === 'critical') return '🔴';
  if (c === 'high') return '🟠';
  if (c === 'medium') return '🟡';
  return '⚪';
}

// CVSS vector parser
const VECTOR_MAP: Record<string, { name: string; values: Record<string, string> }> = {
  AV: { name: 'Attack Vector', values: { N: 'Network', A: 'Adjacent', L: 'Local', P: 'Physical' } },
  AC: { name: 'Attack Complexity', values: { L: 'Low', H: 'High' } },
  PR: { name: 'Privileges Required', values: { N: 'None', L: 'Low', H: 'High' } },
  UI: { name: 'User Interaction', values: { N: 'None', R: 'Required' } },
  S: { name: 'Scope', values: { U: 'Unchanged', C: 'Changed' } },
  C: { name: 'Confidentiality', values: { H: 'High', L: 'Low', N: 'None' } },
  I: { name: 'Integrity', values: { H: 'High', L: 'Low', N: 'None' } },
  A: { name: 'Availability', values: { H: 'High', L: 'Low', N: 'None' } },
};

function parseVector(vec: string | undefined | null): { key: string; name: string; value: string; label: string; colorClass: string }[] {
  if (!vec) return [];
  const parts = vec.split('/');
  const result: { key: string; name: string; value: string; label: string; colorClass: string }[] = [];
  for (const part of parts) {
    const m = part.match(/^(AV|AC|PR|UI|S|C|I|A):([A-Z])$/);
    if (m) {
      const key = m[1];
      const val = m[2];
      const meta = VECTOR_MAP[key] || { name: key, values: {} };
      const label = meta.values[val] || val;
      const isHigh = val === 'H' || val === 'C' || val === 'N' && key !== 'PR' && key !== 'UI';
      const colorClass = val === 'H' || val === 'C' ? 'val-high' : val === 'L' || val === 'A' || val === 'R' ? 'val-medium' : 'val-low';
      result.push({ key, name: meta.name, value: val, label, colorClass });
    }
  }
  return result;
}

const metrics = parseVector(cve.vector);
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={`${cve.id} — ${cve.severity} Vulnerability`} description={cve.description?.slice(0, 160)} />
    <style>
      .cv-detail { max-width: 900px; margin: 0 auto; padding: 2rem 1.5rem; }
      .cv-hero { border: 1px solid var(--hairline-strong, #2a2a36); border-radius: 12px; padding: 1.5rem; display: flex; gap: 1.5rem; border-top: 3px solid; background: var(--surface-1, #14141b); margin-bottom: 1.5rem; }
      .cv-hero-gauge { display: flex; flex-direction: column; align-items: center; justify-content: center; min-width: 100px; }
      .cv-hero-score { font-size: 2.2rem; font-weight: 700; line-height: 1; }
      .cv-hero-sev { font-size: 0.8rem; font-weight: 500; text-transform: uppercase; letter-spacing: 0.05em; margin-top: 0.3rem; }
      .cv-hero-meta { flex: 1; display: flex; flex-direction: column; gap: 0.4rem; }
      .cv-hero-id { font-size: 0.75rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em; color: var(--ink-tertiary, #4a4a58); }
      .cv-hero-title { font-size: 1.3rem; font-weight: 600; margin: 0; color: var(--ink, #e8e8ed); }
      .cv-hero-row { display: flex; gap: 0.5rem; flex-wrap: wrap; font-size: 0.8rem; color: var(--ink-muted, #a0a0b0); }
      .cv-hero-row strong { color: var(--ink, #e8e8ed); }
      .badge { display: inline-block; padding: 0.15rem 0.5rem; border-radius: 4px; font-size: 0.75rem; font-weight: 600; }
      .badge-sev { color: #fff; }
      .badge-source { background: var(--surface-2, #1a1a23); color: var(--ink-muted, #a0a0b0); border: 1px solid var(--hairline, #23232e); }

      .cv-vector { color: var(--ink-subtle, #6b6b7b); font-family: 'JetBrains Mono', monospace; font-size: 0.75rem; word-break: break-all; }

      .cv-body { line-height: 1.65; color: var(--ink, #e8e8ed); margin-bottom: 2rem; }
      .cv-body p { margin: 0 0 1rem; color: #c8c8d0; }

      .cv-table-wrap { border: 1px solid var(--hairline, #23232e); border-radius: 10px; overflow: hidden; margin-bottom: 2rem; }
      .cv-table-wrap h3 { margin: 0; padding: 0.8rem 1rem; font-size: 0.9rem; background: var(--surface-1, #14141b); border-bottom: 1px solid var(--hairline, #23232e); color: var(--ink, #e8e8ed); }
      .cv-table { width: 100%; border-collapse: collapse; }
      .cv-table th { text-align: left; padding: 0.6rem 1rem; font-size: 0.78rem; font-weight: 600; color: var(--ink-tertiary, #4a4a58); text-transform: uppercase; letter-spacing: 0.04em; background: var(--surface-2, #1a1a23); border-bottom: 1px solid var(--hairline, #23232e); }
      .cv-table td { padding: 0.55rem 1rem; font-size: 0.85rem; border-bottom: 1px solid var(--hairline, #23232e); }
      .cv-table tr:last-child td { border-bottom: none; }
      .cv-table .metric { color: var(--ink, #e8e8ed); font-weight: 500; white-space: nowrap; }
      .cv-table .value { font-family: 'JetBrains Mono', monospace; font-size: 0.82rem; font-weight: 600; white-space: nowrap; }
      .cv-table .meaning { color: #b0b0c0; }
      .val-critical { color: #ef4444; }
      .val-high { color: #f97316; }
      .val-medium { color: #eab308; }
      .val-low { color: #22c55e; }
      .val-none { color: #6b7280; }

      @media (max-width: 600px) {
        .cv-hero { flex-direction: column; align-items: flex-start; gap: 0.8rem; }
        .cv-hero-gauge { flex-direction: row; gap: 0.8rem; min-width: auto; }
        .cv-table .meaning { display: none; }
      }
    </style>
  </head>
  <body>
    <Header />
    <main class="cv-detail">
      <div class="cv-hero" style="border-top-color: {sevColor(cve.severity)}">
        <div class="cv-hero-gauge">
          <div class="cv-hero-score" style="color: {sevColor(cve.severity)}">{emoji(cve.severity)} {cve.cvss?.toFixed(1)}</div>
          <div class="cv-hero-sev" style="color: {sevColor(cve.severity)}">{cve.severity || 'Unknown'}</div>
        </div>
        <div class="cv-hero-meta">
          <div class="cv-hero-id">{cve.id}</div>
          <h1 class="cv-hero-title">{cve.id}</h1>
          <div class="cv-hero-row">
            <span class="badge badge-sev" style="background: {sevColor(cve.severity)}">{cve.severity}</span>
            <span class="badge badge-source">NVD</span>
            <span><strong>Published:</strong> {date}</span>
            {modDate && <span><strong>Modified:</strong> {modDate}</span>}
          </div>
          <div class="cv-vector">{cve.vector || ''}</div>
        </div>
      </div>

      <div class="cv-body">
        <p>{cve.description || 'No description available.'}</p>
      </div>

      {
        metrics && metrics.length > 0 && (
        <div class="cv-table-wrap">
          <h3>CVSS Vector Breakdown</h3>
          <table class="cv-table">
            <thead>
              <tr><th>Metric</th><th>Value</th><th class="meaning">What It Means</th></tr>
            </thead>
            <tbody>
              {metrics.map((m: any) => <tr>
                <td class="metric">{m.name}</td>
                <td class="value" style={`color: ${m.colorClass === 'val-high' ? '#ef4444' : m.colorClass === 'val-medium' ? '#eab308' : '#22c55e'}`}>{m.value}</td>
                <td class="meaning">{m.label}</td>
              </tr>)}
            </tbody>
          </table>
        </div>
        )
      }

      <div style="margin-top: 2rem; text-align: center;">
        <a href="/cves/" style="color: var(--accent, #00d4aa); text-decoration: none; font-size: 0.9rem;">← Back to CVE database</a>
      </div>

      {
        cve.references && cve.references.length > 0 && (
        <div class="cv-table-wrap" style="margin-top: 1.5rem;">
          <h3>References</h3>
          <div style="padding: 0.8rem 1rem;">
            {cve.references.map((ref: string) => (
              <div style="margin-bottom: 0.4rem; word-break: break-all;">
                <a href={ref} target="_blank" rel="noopener" style="color: var(--accent, #00d4aa); font-size: 0.85rem;">{ref}</a>
              </div>
            ))}
          </div>
        </div>
        )
      }
    </main>
    <Footer />
  </body>
</html>
