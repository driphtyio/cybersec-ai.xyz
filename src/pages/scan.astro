---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import AttackViz from '../components/AttackViz.astro';
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title="Security Posture Scanner — Cybersec AI" description="Scan any domain for DNS, SSL, and security header issues. Free. 10 seconds. No login." />
    <style>
      .s-page { width: 100%; max-width: 1100px; margin: 0 auto; padding: 2rem 1.5rem 4rem; }

      /* ── Header ── */
      .s-header { margin-bottom: 2rem; }
      .s-header h1 { margin: 0 0 0.4rem; font-size: clamp(1.6rem, 3vw, 2.2rem); }
      .s-header p { margin: 0; color: rgb(var(--gray, 130,145,170)); font-size: 0.95rem; }

      /* ── Scan card ── */
      .s-card {
        background: var(--bg-card, #161b22);
        border: 1px solid var(--border, #2d3b4e);
        border-radius: 14px;
        padding: 1.5rem;
        margin-bottom: 1.5rem;
        position: relative;
        overflow: hidden;
      }
      .s-card::before {
        content: '';
        position: absolute; top: 0; left: 0; right: 0; height: 2px;
        background: linear-gradient(90deg, transparent, var(--accent, #00d4aa), transparent);
        opacity: 0.6;
      }
      .s-flex { display: flex; gap: 0.5rem; margin-bottom: 0.75rem; flex-wrap: wrap; }
      .s-pill {
        padding: 0.4rem 1.2rem; border: 1px solid var(--border, #2d3b4e); border-radius: 100px;
        background: transparent; color: var(--text-secondary, #94a3b8); cursor: pointer;
        font-size: 0.82rem; font-weight: 500; transition: all 0.2s;
      }
      .s-pill:hover { border-color: var(--accent, #00d4aa); color: var(--accent, #00d4aa); background: rgba(0,212,170,0.06); }
      .s-input-wrap { display: flex; gap: 0.5rem; }
      .s-input-wrap input {
        flex: 1; padding: 0.75rem 1rem;
        border: 1px solid var(--border, #2d3b4e); border-radius: 10px;
        background: rgba(13,17,23,0.6); color: #e8edf4;
        font-size: 0.95rem; outline: none; transition: border-color 0.2s, box-shadow 0.2s;
        box-sizing: border-box;
      }
      .s-input-wrap input:focus {
        border-color: var(--accent, #00d4aa);
        box-shadow: 0 0 0 3px rgba(0,212,170,0.1);
      }
      .s-input-wrap input::placeholder { color: #555; }
      .s-btn {
        padding: 0.75rem 1.75rem; background: var(--accent, #00d4aa); color: #0d1117;
        border: none; border-radius: 10px; font-weight: 600; font-size: 0.9rem;
        cursor: pointer; white-space: nowrap; transition: opacity 0.2s, transform 0.15s;
      }
      .s-btn:hover { opacity: 0.9; transform: translateY(-1px); }
      .s-btn:disabled { opacity: 0.4; cursor: not-allowed; transform: none; }
      .s-err { color: #ef4444; padding: 0.75rem 1rem; background: rgba(239,68,68,.08); border-radius: 8px; margin-bottom: 1rem; border: 1px solid rgba(239,68,68,.15); }
      .spinner { display: inline-block; width: 14px; height: 14px; border: 2px solid rgba(255,255,255,.15); border-top-color: var(--accent); border-radius: 50%; animation: sp .6s linear infinite; vertical-align: middle; margin-right: 5px; }
      @keyframes sp { to { transform: rotate(360deg); } }

      /* ── Result hero card ── */
      .s-result {
        background: var(--bg-card, #161b22);
        border: 1px solid var(--border, #2d3b4e);
        border-radius: 14px; padding: 1.5rem 1.75rem;
        margin-bottom: 1.5rem;
        position: relative;
      }
      .s-result::before {
        content: '';
        position: absolute; top: 0; left: 2rem; right: 2rem; height: 2px;
        background: linear-gradient(90deg, transparent, var(--accent, #00d4aa), transparent);
      }
      .s-result-top { display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
      .s-result-l {
        display: flex; align-items: center; gap: 1rem;
        font-size: 1.15rem; font-weight: 700; color: #e8edf4;
      }
      .s-result-domain { font-family: 'JetBrains Mono', 'Fira Code', monospace; }
      .s-score-badge { font-weight: 700; font-size: 1.4rem; }
      .s-result-r { text-align: right; }
      .s-result-verdict { font-size: 0.85rem; color: rgb(var(--gray, 130,145,170)); }
      .s-result-meta { font-size: 0.75rem; color: #555; margin-top: 3px; }
      .s-result-stats { display: flex; gap: 0.4rem; flex-wrap: wrap; margin-top: 0.75rem; padding-top: 0.75rem; border-top: 1px solid var(--border-light, #1e2a3a); }

      /* ── Stat pills ── */
      .s-stat {
        display: inline-flex; align-items: center; gap: 0.3rem;
        padding: 0.2rem 0.6rem; border-radius: 6px;
        font-size: 0.75rem; font-weight: 600;
      }
      .s-green { background: rgba(0,212,170,0.1); color: #00d4aa; }
      .s-red { background: rgba(239,68,68,0.1); color: #ef4444; }
      .s-orange { background: rgba(249,115,22,0.1); color: #f97316; }
      .s-yellow { background: rgba(234,179,8,0.1); color: #eab308; }

      /* ── Section + table ── */
      .s-section { margin-bottom: 1.5rem; }
      .s-section-title {
        padding: 0.65rem 1rem; font-size: 0.82rem; font-weight: 600;
        background: var(--bg-card, #161b22);
        border: 1px solid var(--border, #2d3b4e);
        border-bottom: none; border-radius: 12px 12px 0 0;
        display: flex; align-items: center; gap: 0.5rem;
        color: #e8edf4;
      }
      .s-section-title .s-count { font-weight: 400; color: #555; font-size: 0.75rem; margin-left: auto; }
      .s-section .s-table-wrap {
        border: 1px solid var(--border, #2d3b4e); border-top: none;
        border-radius: 0 0 12px 12px; overflow: hidden;
      }
      .s-table { width: 100%; border-collapse: collapse; font-size: 0.85rem; }
      .s-table thead th {
        text-align: left; padding: 0.6rem 1rem; font-size: 0.73rem; font-weight: 600;
        text-transform: uppercase; letter-spacing: 0.04em;
        color: #555; background: rgba(255,255,255,0.02);
        border-bottom: 1px solid var(--border-light, #1e2a3a); white-space: nowrap;
      }
      .s-table tbody td { padding: 0.6rem 1rem; border-bottom: 1px solid var(--border-light, #1e2a3a); vertical-align: top; }
      .s-table tbody tr:last-child td { border-bottom: none; }
      .s-table tbody tr { transition: background 0.12s; }
      .s-table tbody tr:hover { background: rgba(0,212,170,0.03); }
      .s-row-fail td { background: rgba(239,68,68,.02); }
      .s-table tr.s-row-fail:hover td { background: rgba(239,68,68,.05); }
      .chk-name { color: #e8edf4; font-weight: 500; font-size: 0.82rem; white-space: nowrap; }
      .chk-detail { color: #6b7280; font-size: 0.78rem; margin-top: 2px; }
      .chk-ctx { color: #9ca3af; font-size: 0.78rem; line-height: 1.5; }
      .chk-ctx .fix {
        margin-top: 5px; padding: 5px 10px; font-size: 0.76rem;
        background: rgba(0,212,170,.05); border-left: 2px solid var(--accent, #00d4aa);
        border-radius: 4px; color: #b0b0c0;
      }
      .chk-ctx .fix strong { color: var(--accent, #00d4aa); }

      /* ── Severity badges ── */
      .sev-badge {
        display: inline-block; padding: 0.15rem 0.5rem; border-radius: 4px;
        font-size: 0.72rem; font-weight: 600; color: #fff;
      }
      .sev-critical { background: #ef4444; }
      .sev-high { background: #f97316; }
      .sev-medium { background: #eab308; color: #0d1117; }

      /* ── CTA ── */
      .s-cta {
        margin-top: 2rem; padding: 2rem; text-align: center;
        border: 1px solid var(--border, #2d3b4e); border-radius: 14px;
        background: var(--bg-card, #161b22); position: relative; overflow: hidden;
      }
      .s-cta h3 { margin: 0 0 0.4rem; font-size: 1.1rem; color: #f0f6fc; }
      .s-cta p { color: #6b7280; font-size: 0.85rem; margin: 0 0 1rem; max-width: 450px; margin-left: auto; margin-right: auto; }
      .s-cta a {
        display: inline-block; padding: 0.6rem 1.5rem;
        background: var(--accent, #00d4aa); color: #0d1117;
        border-radius: 10px; font-weight: 600; text-decoration: none; font-size: 0.85rem;
        transition: opacity 0.2s, transform 0.15s;
      }
      .s-cta a:hover { opacity: 0.9; transform: translateY(-1px); }

      /* ── Responsive ── */
      @media (max-width: 640px) {
        .s-result-top { flex-direction: column; align-items: flex-start; }
        .s-flex { flex-direction: column; }
        .s-btn { width: 100%; }
        .s-page { padding: 1rem; }
        .s-input-wrap { flex-direction: column; }
        .chk-ctx { display: none; }
      }
      @media (min-width: 1200px) {
        .s-page { max-width: 1240px; }
        .s-hero { padding: 1.5rem 2rem; }
        .s-card { padding: 1.75rem 2rem; }
      }
      @media (min-width: 1600px) {
        .s-page { max-width: 1440px; padding: 3rem 1.5rem 5rem; }
      }
    </style>
  </head>
  <body>
    <Header />
    <main class="s-page">
      <div class="s-header">
        <h1>Security Posture Scanner</h1>
        <p>Check what enterprise buyers see when they audit your domain. 10 seconds. No login.</p>
      </div>

      <div style="margin-bottom:1.5rem">
        <AttackViz />
      </div>

      <div class="s-card">
        <div class="s-flex">
          <button class="s-pill" data-d="stripe.com">stripe.com</button>
          <button class="s-pill" data-d="github.com">github.com</button>
          <button class="s-pill" data-d="example.com">example.com</button>
        </div>
        <div class="s-input-wrap">
          <input type="text" id="domain" placeholder="yourdomain.com" spellcheck="false" />
          <button class="s-btn" id="scan-btn">Scan</button>
        </div>
      </div>

      <div id="results"></div>

      <script is:inline>
        const domain = document.getElementById('domain');
        const btn = document.getElementById('scan-btn');
        const results = document.getElementById('results');

        btn.addEventListener('click', async () => {
          const d = domain.value.trim().replace(/^https?:\/\//, '').replace(/\/.*$/, '');
          if (!d || !/^[a-zA-Z0-9][a-zA-Z0-9.-]+\.[a-zA-Z]{2,}$/.test(d)) {
            results.innerHTML = '<div class="s-err">Enter a valid domain (e.g. example.com)</div>';
            return;
          }
          btn.disabled = true;
          btn.innerHTML = '<span class="spinner"></span> Scanning…';
          results.innerHTML = '';

          try {
            const resp = await fetch('/api/scan?domain=' + encodeURIComponent(d));
            if (!resp.ok) {
              const err = await resp.json();
              results.innerHTML = '<div class="s-err">' + (err.error || 'Scan failed') + '</div>';
              return;
            }
            const data = await resp.json();
            const fc = data.total - data.passed;
            const sc = data.score || 0;
            const clr = sc >= 90 ? '#00d4aa' : sc >= 70 ? '#8bc34a' : sc >= 50 ? '#eab308' : sc >= 30 ? '#f97316' : '#ef4444';
            const verdict = fc === 0 ? 'All checks passed, no issues found'
              : fc === 1 ? '1 issue needs attention'
              : fc + ' issues need attention';
            let h = '';

            // ═══ HERO CARD ═══
            h += '<div class="s-result">';
            h += '<div class="s-result-top">';
            h += '<div class="s-result-l">';
            h += '<span class="s-result-domain">' + data.domain + '</span>';
            h += '<span class="s-score-badge" style="color:' + clr + '">' + sc + '/100</span>';
            h += '</div>';
            h += '<div class="s-result-r">';
            h += '<div class="s-result-verdict">' + verdict + '</div>';
            h += '<div class="s-result-meta">' + data.passed + '/' + data.total + ' checks · ' + new Date(data.timestamp).toLocaleString() + '</div>';
            h += '</div></div>';
            h += '<div class="s-result-stats">';
            const s = data.severityCounts;
            h += '<span class="s-stat s-green">' + data.passed + ' passed</span>';
            if (s.critical) h += '<span class="s-stat s-red">' + s.critical + ' critical</span>';
            if (s.high) h += '<span class="s-stat s-orange">' + s.high + ' high</span>';
            if (s.medium) h += '<span class="s-stat s-yellow">' + s.medium + ' medium</span>';
            if (!s.critical && !s.high && !s.medium) h += '<span class="s-stat s-green">all clear</span>';
            h += '</div></div>';

            // ═══ CATEGORY TABLES ═══
            for (const [cat, chks] of Object.entries(data.categories)) {
              const em = chks[0]?.emoji || '';
              const ok = chks.filter(c => c.passed).length;
              h += '<div class="s-section">';
              h += '<div class="s-section-title">' + em + ' ' + cat + ' <span class="s-count">' + ok + '/' + chks.length + '</span></div>';
              h += '<div class="s-table-wrap"><table class="s-table">';
              h += '<thead><tr><th>Check</th><th style="width:50px">Result</th><th style="width:65px">Severity</th><th>What It Means</th></tr></thead>';
              h += '<tbody>';
              for (const c of chks) {
                const rcls = c.passed ? '' : 's-row-fail';
                const icon = c.passed ? '✓' : '✗';
                const sevClass = c.passed ? '' : 'sev-' + c.severity;
                const sevLabel = c.passed ? 'Pass' : c.severity;
                const fixHtml = (!c.passed && c.remediation)
                  ? '<div class="fix"><strong>Fix:</strong> ' + c.remediation + '</div>'
                  : '';
                h += '<tr class="' + rcls + '">';
                h += '<td><div class="chk-name">' + c.label + '</div><div class="chk-detail">' + c.detail + '</div></td>';
                h += '<td style="font-weight:600;color:' + (c.passed ? '#00d4aa' : '#ef4444') + '">' + icon + '</td>';
                h += '<td>' + (c.passed ? '<span style="color:#6b7280;font-size:0.72rem">—</span>' : '<span class="sev-badge ' + sevClass + '">' + sevLabel + '</span>') + '</td>';
                h += '<td class="chk-ctx">' + c.context + fixHtml + '</td>';
                h += '</tr>';
              }
              h += '</tbody></table></div></div>';
            }

            // ═══ CTA ═══
            h += '<div class="s-cta">';
            h += '<h3>Need a deeper look?</h3>';
            h += '<p>This is a surface scan. Get a full security assessment with auto-filled questionnaires, gap analysis, and fix plans.</p>';
            h += '<a href="/">Get the full assessment →</a>';
            h += '</div>';

            results.innerHTML = h;
          } catch (e) {
            results.innerHTML = '<div class="s-err">Scan failed: ' + e.message + '</div>';
          } finally {
            btn.disabled = false;
            btn.textContent = 'Scan';
          }
        });

        document.querySelectorAll('[data-d]').forEach(b => {
          b.addEventListener('click', () => {
            domain.value = b.dataset.d;
            btn.click();
          });
        });

        domain.addEventListener('keydown', e => { if (e.key === 'Enter') btn.click(); });
      </script>
    </main>
    <Footer />
  </body>
</html>
