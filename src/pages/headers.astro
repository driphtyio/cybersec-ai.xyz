---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title="Security Headers Checker — Cybersec AI" description="Check your website's security headers (CSP, HSTS, X-Frame-Options, and more). Free A-F grading with remediation steps. No login required." />
    <style>
      .h-page { max-width: 800px; margin: 0 auto; padding: 2rem 1.5rem; }
      h1 { margin: 0 0 0.3rem; }
      .h-sub { margin: 0 0 1.5rem; color: var(--ink-muted, #a0a0b0); font-size: 0.9rem; }

      .h-search { margin-bottom: 1rem; }
      .h-search input {
        width: 100%; padding: 0.7rem 1rem; border: 1px solid var(--border, #2d3b4e);
        border-radius: 8px; background: var(--bg-card, #161b22); color: #e8edf4;
        font-size: 0.95rem; outline: none; box-sizing: border-box;
      }
      .h-search input:focus { border-color: var(--accent, #00d4aa); }
      .h-search input::placeholder { color: #555; }

      .h-flex { display: flex; gap: 0.5rem; margin-bottom: 0.75rem; flex-wrap: wrap; }
      .h-pill {
        padding: 0.35rem 1rem; border: 1px solid var(--border, #2d3b4e); border-radius: 20px;
        background: transparent; color: var(--ink-muted, #a0a0b0); cursor: pointer;
        font-size: 0.82rem; font-weight: 500; transition: all 0.15s;
      }
      .h-pill:hover { border-color: var(--accent, #00d4aa); color: var(--accent, #00d4aa); }
      .h-btn {
        padding: 0.7rem 1.75rem; background: var(--accent, #00d4aa); color: #0d1117;
        border: none; border-radius: 8px; font-weight: 600; font-size: 0.9rem; cursor: pointer;
        margin-left: auto; white-space: nowrap;
      }
      .h-btn:hover { opacity: 0.85; }
      .h-btn:disabled { opacity: 0.4; cursor: not-allowed; }

      .h-err { color: #ef4444; padding: 0.75rem 1rem; background: rgba(239,68,68,.08); border-radius: 8px; margin-bottom: 1rem; border: 1px solid rgba(239,68,68,.15); }

      /* ── Hero card (scan page style) ── */
      .h-hero {
        background: var(--bg-card, #161b22); border: 1px solid var(--border, #2d3b4e);
        border-radius: 12px; padding: 1.25rem 1.5rem; margin-bottom: 1.25rem;
      }
      .h-hero-top { display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
      .h-hero-l {
        display: flex; align-items: center; gap: 0.75rem;
        font-size: 1.2rem; font-weight: 700; color: #e8edf4;
      }
      .h-grade-badge { font-weight: 700; font-size: 1.2rem; }
      .h-hero-r { text-align: right; }
      .h-hero-verdict { font-size: 0.82rem; color: var(--ink-muted, #a0a0b0); }
      .h-hero-meta { font-size: 0.75rem; color: #555; margin-top: 2px; }

      .h-hero-stats { display: flex; gap: 0.4rem; flex-wrap: wrap; margin-top: 0.75rem; padding-top: 0.75rem; border-top: 1px solid var(--border-light, #1e2a3a); }

      /* ── Stat pills ── */
      .h-stat {
        display: inline-block; padding: 0.15rem 0.5rem; border-radius: 4px;
        font-size: 0.72rem; font-weight: 600;
      }
      .h-green { background: rgba(0,212,170,0.12); color: #00d4aa; }
      .h-red { background: rgba(239,68,68,0.12); color: #ef4444; }
      .h-orange { background: rgba(249,115,22,0.12); color: #f97316; }
      .h-yellow { background: rgba(234,179,8,0.12); color: #eab308; }

      /* ── Grade badge colors ── */
      .g-a { color: #00d4aa; }
      .g-b { color: #8bc34a; }
      .g-c { color: #eab308; }
      .g-d { color: #f97316; }
      .g-f { color: #ef4444; }
      .bg-a { background: rgba(0,212,170,0.12); }
      .bg-b { background: rgba(139,195,74,0.12); }
      .bg-c { background: rgba(234,179,8,0.12); }
      .bg-d { background: rgba(249,115,22,0.12); }
      .bg-f { background: rgba(239,68,68,0.12); }

      /* ── Section + table (scan/CVE page style) ── */
      .h-section { margin-bottom: 2rem; }
      .h-section-title {
        padding: 0.6rem 0.8rem; font-size: 0.85rem; font-weight: 600;
        background: var(--bg-card, #161b22); border: 1px solid var(--border, #2d3b4e);
        border-bottom: none; border-radius: 10px 10px 0 0;
        display: flex; align-items: center; gap: 0.4rem;
      }
      .h-section-title .h-count { font-weight: 400; color: var(--ink-muted, #a0a0b0); font-size: 0.75rem; margin-left: auto; }
      .h-section table { border: 1px solid var(--border, #2d3b4e); border-radius: 0 0 10px 10px; border-top: none; }

      .h-table { width: 100%; border-collapse: collapse; font-size: 0.85rem; }
      .h-table thead th {
        text-align: left; padding: 0.6rem 0.8rem; font-size: 0.75rem; font-weight: 600;
        text-transform: uppercase; letter-spacing: 0.04em;
        color: var(--ink-tertiary, #4a4a58); background: var(--surface-2, #1a1a23);
        border-bottom: 1px solid var(--border, #2d3b4e); white-space: nowrap;
      }
      .h-table tbody td { padding: 0.6rem 0.8rem; border-bottom: 1px solid var(--border-light, #1e2a3a); vertical-align: top; }
      .h-table tbody tr { transition: background 0.12s; }
      .h-table tbody tr:hover { background: rgba(0,212,170,0.04); }
      .hd-name { color: #e8edf4; font-weight: 500; font-size: 0.82rem; white-space: nowrap; }
      .hd-detail { color: var(--ink-muted, #a0a0b0); font-size: 0.78rem; margin-top: 1px; }
      .hd-ctx { color: #b0b0c0; font-size: 0.78rem; line-height: 1.4; }
      .hd-ctx .fix {
        margin-top: 4px; padding: 4px 8px; font-size: 0.76rem;
        background: rgba(0,212,170,.06); border-left: 2px solid var(--accent, #00d4aa);
        border-radius: 3px; color: #bbb;
      }
      .hd-ctx .fix strong { color: var(--accent, #00d4aa); }

      .h-row-fail td { background: rgba(239,68,68,.03); }
      .h-table tr.h-row-fail:hover td { background: rgba(239,68,68,.07); }

      .h-sev { display: inline-block; padding: 0.15rem 0.5rem; border-radius: 4px; font-size: 0.72rem; font-weight: 600; color: #fff; }
      .sev-critical { background: #ef4444; }
      .sev-high { background: #f97316; }
      .sev-medium { background: #eab308; color: #0d1117; }
      .sev-pass { background: #6b7280; }

      /* ── CTA ── */
      .h-cta {
        margin-top: 1.5rem; padding: 1.5rem; text-align: center;
        border: 1px solid var(--border, #2d3b4e); border-radius: 12px;
        background: var(--bg-card, #161b22);
      }
      .h-cta h3 { margin: 0 0 0.3rem; font-size: 1rem; }
      .h-cta p { color: var(--ink-muted, #a0a0b0); font-size: 0.85rem; margin: 0 0 0.75rem; }
      .h-cta a {
        display: inline-block; padding: 0.5rem 1.5rem;
        background: var(--accent, #00d4aa); color: #0d1117;
        border-radius: 8px; font-weight: 600; text-decoration: none; font-size: 0.85rem;
      }

      .spinner { display: inline-block; width: 14px; height: 14px; border: 2px solid rgba(255,255,255,.15); border-top-color: var(--accent); border-radius: 50%; animation: sp .6s linear infinite; vertical-align: middle; margin-right: 5px; }
      @keyframes sp { to { transform: rotate(360deg); } }

      .raw-toggle {
        display: inline-block; margin-top: 1rem; padding: 0.4rem 0.8rem;
        background: transparent; border: 1px solid var(--border); border-radius: 6px;
        color: var(--ink-muted); cursor: pointer; font-size: 0.8rem;
      }
      .raw-json {
        margin-top: 0.5rem; padding: 1rem;
        background: #111; border-radius: 8px;
        font-family: monospace; font-size: 0.75rem;
        white-space: pre-wrap; color: #aaa;
        display: none;
      }

      @media (max-width: 640px) {
        .h-hero-top { flex-direction: column; align-items: flex-start; }
        .h-flex { flex-direction: column; }
        .h-btn { width: 100%; margin-left: 0; }
        .h-page { padding: 1rem; }
      }

      @media (min-width: 1200px) {
        .h-page { max-width: 960px; }
        .h-hero { padding: 1.5rem 2rem; }
      }
      @media (min-width: 1600px) {
        .h-page { max-width: 1100px; padding: 3rem 1.5rem; }
        .h-table { font-size: 0.9rem; }
        .h-table thead th { padding: 0.7rem 1rem; }
        .h-table tbody td { padding: 0.7rem 1rem; }
        .h-hero { padding: 1.75rem 2.5rem; }
        h1 { font-size: 1.8rem; }
        .h-section-title { padding: 0.7rem 1rem; font-size: 0.9rem; }
      }
    </style>
  </head>
  <body>
    <Header />
    <main class="h-page">
      <h1>Security Headers Checker</h1>
      <p class="h-sub">A–F grade for your site's security headers with remediation steps. No login.</p>

      <div class="h-flex">
        <button class="h-pill" data-d="stripe.com">stripe.com</button>
        <button class="h-pill" data-d="github.com">github.com</button>
        <button class="h-pill" data-d="example.com">example.com</button>
        <button class="h-btn" id="scan-btn">Check Headers</button>
      </div>

      <div class="h-search">
        <input type="text" id="domain" placeholder="yourdomain.com" spellcheck="false" />
      </div>

      <div id="results"></div>

      <script is:inline>
        const domain = document.getElementById('domain');
        const btn = document.getElementById('scan-btn');
        const results = document.getElementById('results');

        function gradeColor(g) {
          return g === 'A' ? '#00d4aa' : g === 'B' ? '#8bc34a' : g === 'C' ? '#eab308' : g === 'D' ? '#f97316' : '#ef4444';
        }
        function gradeDesc(g) {
          return g === 'A' ? 'Excellent' : g === 'B' ? 'Good' : g === 'C' ? 'Fair' : g === 'D' ? 'Poor' : 'Fail';
        }
        function gradeClass(g) { return 'g-' + g.toLowerCase(); }

        btn.addEventListener('click', async () => {
          const d = domain.value.trim().replace(/^https?:\/\//, '').replace(/\/.*$/, '');
          if (!d || !/^[a-zA-Z0-9][a-zA-Z0-9.-]+\.[a-zA-Z]{2,}$/.test(d)) {
            results.innerHTML = '<div class="h-err">Enter a valid domain (e.g. example.com)</div>';
            return;
          }
          btn.disabled = true;
          btn.innerHTML = '<span class="spinner"></span> Checking…';
          results.innerHTML = '';

          try {
            const resp = await fetch('/api/headers?url=' + encodeURIComponent(d));
            if (!resp.ok) {
              const err = await resp.json();
              results.innerHTML = '<div class="h-err">' + (err.error || 'Check failed') + '</div>';
              return;
            }
            const data = await resp.json();
            if (!data.ok) {
              results.innerHTML = '<div class="h-err">' + (data.error || 'Could not reach ' + d) + '</div>';
              return;
            }

            const clr = gradeColor(data.score);
            const desc = gradeDesc(data.score);
            let h = '';

            // ═══ HERO CARD ═══
            h += '<div class="h-hero">';
            h += '<div class="h-hero-top">';
            h += '<div class="h-hero-l">';
            h += '<span>🛡️ ' + data.domain + '</span>';
            h += '<span class="h-grade-badge ' + gradeClass(data.score) + '">' + data.score + '</span>';
            h += '</div>';
            h += '<div class="h-hero-r">';
            h += '<div class="h-hero-verdict">' + desc + '</div>';
            h += '<div class="h-hero-meta">' + data.ms + 'ms · Final: ' + data.finalHost + '</div>';
            h += '</div></div>';
            h += '<div class="h-hero-stats">';
            h += '<span class="h-stat h-green">✅ ' + data.secureHeaders + '/9 secure headers</span>';
            if (data.infoLeaks > 0) h += '<span class="h-stat h-orange">⚠️ ' + data.infoLeaks + ' info leak' + (data.infoLeaks > 1 ? 's' : '') + '</span>';
            else h += '<span class="h-stat h-green">✨ no leaks</span>';
            h += '</div></div>';

            // ═══ HEADER RESULTS TABLE ═══
            h += '<div class="h-section">';
            h += '<div class="h-section-title">🔒 Header Breakdown <span class="h-count">' + Object.keys(data.results).length + ' checks</span></div>';
            h += '<table class="h-table">';
            h += '<thead><tr><th>Header</th><th style="width:50px">Grade</th><th>Detail</th><th>How to Fix</th></tr></thead>';
            h += '<tbody>';

            for (const [key, r] of Object.entries(data.results)) {
              const label = key.replace(/-/g, ' ').replace(/\b\w/g, c => c.toUpperCase());
              const failed = r.grade !== 'A';
              const rcls = failed ? 'h-row-fail' : '';
              const gc = gradeColor(r.grade);
              const sev = r.grade === 'F' ? 'critical' : r.grade === 'D' ? 'high' : r.grade === 'C' ? 'medium' : 'pass';
              h += '<tr class="' + rcls + '">';
              h += '<td><div class="hd-name">' + label + '</div></td>';
              h += '<td><span style="font-weight:700;font-size:1rem;color:' + gc + '">' + r.grade + '</span></td>';
              h += '<td class="hd-detail">' + r.label + '</td>';
              h += '<td class="hd-ctx">' + (r.remediation ? '<div class="fix"><strong>🔧 Fix:</strong> ' + r.remediation + '</div>' : '<span style="color:#6b7280">—</span>') + '</td>';
              h += '</tr>';
            }

            h += '</tbody></table></div>';

            // Raw toggle
            h += '<button class="raw-toggle" id="raw-toggle">Show raw JSON</button>';
            h += '<div class="raw-json" id="raw-json">' + JSON.stringify(data, null, 2) + '</div>';

            // ═══ CTA ═══
            h += '<div class="h-cta">';
            h += '<h3>🔒 Need a deeper look?</h3>';
            h += '<p>Headers are just the surface. Get a deep security assessment — DNS, email security, CVE correlation, and questionnaire auto-fill.</p>';
            h += '<a href="/scan/">Full Security Assessment →</a>';
            h += '</div>';

            results.innerHTML = h;

            document.getElementById('raw-toggle').addEventListener('click', function() {
              const rj = document.getElementById('raw-json');
              rj.style.display = rj.style.display === 'block' ? 'none' : 'block';
            });

          } catch (e) {
            results.innerHTML = '<div class="h-err">Check failed: ' + e.message + '</div>';
          } finally {
            btn.disabled = false;
            btn.textContent = 'Check Headers';
          }
        });

        document.querySelectorAll('[data-d]').forEach(b => {
          b.addEventListener('click', () => {
            domain.value = b.dataset.d;
            btn.click();
          });
        });

        domain.addEventListener('keydown', e => { if (e.key === 'Enter') btn.click(); });
      </script>
    </main>
    <Footer />
  </body>
</html>
