---
import { SITE_TITLE } from '../consts';
---

<header>
  <nav>
    <div class="nav-inner">
      <h2><a href="/">{SITE_TITLE}</a></h2>
      <div class="nav-links">
        <a href="/scan/">Scanner</a>
        <a href="/cves/">CVEs</a>
        <a href="/blog/">Blog</a>
      </div>
    </div>
  </nav>
</header>
<style>
  header {
    position: sticky; top: 0; z-index: 100;
    background: rgba(13,17,23,0.85);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom: 1px solid var(--border-light);
    padding: 0 1em;
  }
  .nav-inner {
    max-width: 1100px; margin: 0 auto;
    display: flex; align-items: center; justify-content: space-between;
  }
  h2 { margin: 0; font-size: 1em; }
  h2 a {
    text-decoration: none; color: #f0f6fc;
    font-weight: 600; padding: 0.85em 0; display: inline-block;
  }
  h2 a:hover { color: var(--accent); }
  .nav-links { display: flex; gap: 1.2em; align-items: center; }
  .nav-links a {
    color: rgb(var(--gray)); font-size: 0.85em; font-weight: 500;
    text-decoration: none; padding: 0.5em 0;
    border-bottom: 2px solid transparent; transition: color 0.15s, border-color 0.15s;
  }
  .nav-links a:hover { color: var(--accent); border-bottom-color: var(--accent); }
</style>
