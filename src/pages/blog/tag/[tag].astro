---
import { getCollection } from 'astro:content';
import BaseHead from '../../../components/BaseHead.astro';
import Footer from '../../../components/Footer.astro';
import Header from '../../../components/Header.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../../../consts';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  const allTags = [...new Set(posts.flatMap(p => p.data.tags || []))].sort();
  return allTags.map(tag => ({
    params: { tag: tag.toLowerCase().replace(/\s+/g, '-') },
    props: { tag, posts: posts.filter(p => (p.data.tags || []).includes(tag)) },
  }));
}

const { tag, posts } = Astro.props;
const sorted = posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={`${tag} — ${SITE_TITLE}`} description={`Posts about ${tag} on ${SITE_TITLE}`} />
  </head>
  <body>
    <Header />
    <main>
      <h1 class="page-title">#{tag}</h1>
      <p class="page-sub">{sorted.length} post{sorted.length !== 1 ? 's' : ''}</p>

      <div class="post-grid">
        {sorted.map((post, i) => (
          <a href={`/blog/${post.id}/`} class="post-card" style={`--i: ${i}`}>
            {post.data.heroImage && (
              <img src={post.data.heroImage} alt="" class="card-img" loading="lazy" />
            )}
            <div class="card-body">
              <div class="card-meta">{post.data.pubDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</div>
              <h3>{post.data.title}</h3>
              <p class="card-desc">{post.data.description}</p>
            </div>
          </a>
        ))}
      </div>
    </main>
    <Footer />
  </body>
</html>
<style>
  .page-title { text-align: center; margin-bottom: 0.2em; font-size: 1.8em; color: #f0f6fc; }
  .page-sub { text-align: center; font-size: 0.85em; color: rgb(var(--gray)); margin-bottom: 2em; }
  .post-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 1.5em; }
  .post-card { display: flex; flex-direction: column; background: var(--bg-card); border: 1px solid var(--border-light); border-radius: 14px; overflow: hidden; text-decoration: none; transition: transform 0.3s, border-color 0.3s; }
  .post-card:hover { transform: translateY(-4px); border-color: var(--accent); box-shadow: 0 8px 24px rgba(0,0,0,0.25); }
  .card-img { width: 100%; aspect-ratio: 16/9; object-fit: cover; border-bottom: 1px solid var(--border-light); }
  .card-body { padding: 1.25em 1.5em 1.5em; }
  .card-meta { font-size: 0.75em; color: rgb(var(--gray)); margin-bottom: 0.3em; }
  .card-body h3 { margin: 0 0 0.4em; font-size: 1.15em; color: #f0f6fc; transition: color 0.2s; }
  .post-card:hover h3 { color: var(--accent); }
  .card-desc { font-size: 0.85em; color: rgb(var(--gray)); margin: 0; line-height: 1.5; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
</style>
