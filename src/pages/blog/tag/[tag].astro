---
import { getCollection } from 'astro:content';
import BaseHead from '../../../components/BaseHead.astro';
import Footer from '../../../components/Footer.astro';
import Header from '../../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../../consts';

export async function getStaticPaths() {
  // Only generate pages for the 3 nav tags
  const navTags = ['reviews', 'tutorial', 'comparison'];
  return navTags.map(tag => ({
    params: { tag },
    props: { tag },
  }));
}

const { tag } = Astro.params;
const posts = (await getCollection('blog'))
  .filter(p => (p.data.tags || []).some(t => t.toLowerCase() === tag))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const tagLabel = tag.charAt(0).toUpperCase() + tag.slice(1);
const pageTitle = `${tagLabel} — ${SITE_TITLE}`;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={pageTitle} description={`No-code ${tagLabel.toLowerCase()} — hands-on reviews, tutorials, and comparisons.`} />
  </head>
  <body>
    <Header />
    <main>
      <div class="page-head">
        <h1 class="page-title">{tagLabel}</h1>
        <p class="page-desc">{posts.length} {tagLabel.toLowerCase()} post{posts.length !== 1 ? 's' : ''}</p>
        <a href="/blog" class="back-link">← All posts</a>
      </div>

      {posts.length > 0 ? (
        <div class="post-grid">
          {posts.map((post, i) => (
            <a href={`/blog/${post.id}/`} class="post-card" style={`--i: ${i}`}>
              {post.data.heroImage && (
                <img src={post.data.heroImage} alt="" class="card-img" loading="lazy" />
              )}
              <div class="card-body">
                <div class="card-meta">{post.data.pubDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</div>
                <h3>{post.data.title}</h3>
                <p class="card-desc">{post.data.description}</p>
                {post.data.tags && (
                  <div class="card-tags">
                    {post.data.tags.slice(0, 3).map(t => (
                      <span class="card-tag">{t}</span>
                    ))}
                  </div>
                )}
              </div>
            </a>
          ))}
        </div>
      ) : (
        <p class="empty">No posts tagged "{tag}" yet.</p>
      )}
    </main>
    <Footer />
  </body>
</html>

<style>
  .page-head {
    text-align: center;
    margin-bottom: 2em;
  }
  .page-title {
    font-size: 1.8em;
    font-weight: 700;
    color: #f0f6fc;
    margin: 0 0 0.2em;
  }
  .page-desc {
    font-size: 0.9em;
    color: rgb(var(--gray));
    margin: 0 0 0.8em;
  }
  .back-link {
    display: inline-block;
    font-size: 0.82em;
    color: var(--accent);
    text-decoration: none;
    padding: 0.3em 0.8em;
    border: 1px solid var(--border-light);
    border-radius: 8px;
    transition: border-color 0.2s;
  }
  .back-link:hover {
    border-color: var(--accent);
  }
  .post-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1.5em;
  }
  .post-card {
    display: flex;
    flex-direction: column;
    background: var(--bg-card);
    border: 1px solid var(--border-light);
    border-radius: 14px;
    overflow: hidden;
    text-decoration: none;
    transition: transform 0.3s, border-color 0.3s, box-shadow 0.3s;
  }
  .post-card:hover {
    transform: translateY(-4px);
    border-color: var(--accent);
    box-shadow: 0 8px 24px rgba(0,0,0,0.25);
  }
  .card-img {
    width: 100%;
    aspect-ratio: 16/9;
    object-fit: cover;
    border-bottom: 1px solid var(--border-light);
  }
  .card-body {
    padding: 1.25em 1.5em 1.5em;
    flex: 1;
  }
  .card-meta {
    font-size: 0.75em;
    color: rgb(var(--gray));
    margin-bottom: 0.3em;
  }
  .card-body h3 {
    margin: 0 0 0.4em;
    font-size: 1.15em;
    color: #f0f6fc;
    transition: color 0.2s;
  }
  .post-card:hover h3 { color: var(--accent); }
  .card-desc {
    font-size: 0.85em;
    color: rgb(var(--gray));
    margin: 0 0 0.75em;
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .card-tags {
    display: flex;
    gap: 0.4em;
    flex-wrap: wrap;
  }
  .card-tag {
    font-size: 0.7em;
    font-weight: 500;
    color: var(--accent);
    background: rgba(34,197,94,0.06);
    border: 1px solid rgba(34,197,94,0.12);
    padding: 0.15em 0.55em;
    border-radius: 100px;
  }
  .empty {
    text-align: center;
    color: rgb(var(--gray));
    padding: 3em;
  }
  @media (max-width: 480px) {
    .post-grid { grid-template-columns: 1fr; }
  }
</style>
