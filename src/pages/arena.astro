---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import arenaData from '../data/cybersec-ai-arena.json';
import { SITE_TITLE } from '../consts';

const { matches, leaderboard, model_pool, stability } = arenaData;

const builderModels = model_pool.filter(m => m.role === 'builder');
const judgeModels = model_pool.filter(m => m.role === 'judge');

const modelsByProvider = {};
for (const m of model_pool) {
  if (!modelsByProvider[m.provider]) modelsByProvider[m.provider] = [];
  modelsByProvider[m.provider].push(m);
}

const totalMatches = matches.length;
const totalModels = model_pool.length;
const totalProviders = Object.keys(modelsByProvider).length;
const rankedModels = leaderboard.length;

const rankEmojis = ['\u{1F947}', '\u{1F948}', '\u{1F949}'];

const sortedLeaderboard = [...leaderboard].sort((a, b) => b.wins - a.wins || b.avgScore - a.avgScore);

const sortedMatches = [...matches]
  .filter(m => m.type !== 'router-selection')
  .sort((a, b) => new Date(b.date) - new Date(a.date));

function groupByProvider(models) {
  const grouped = {};
  for (const m of models) {
    if (!grouped[m.provider]) grouped[m.provider] = [];
    grouped[m.provider].push(m);
  }
  return Object.entries(grouped).sort((a, b) => a[0].localeCompare(b[0]));
}
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={`Arena — ${SITE_TITLE}`} description="CyberSec AI Arena — model battle arena for security content matches." />
    <style>
      :root { --accent: #ef4444; --accent-dim: rgba(239,68,68,0.1); }
      .arena { max-width: 860px; margin: 0 auto; padding: 2rem 1.5rem; }
      .hero { text-align: center; margin-bottom: 2rem; }
      .hero-title { font-size: 2rem; margin-bottom: 0.5rem; }
      .hero-subtitle { color: var(--text-muted); font-size: 0.95rem; }
      .stats-bar { display: flex; justify-content: center; gap: 1rem; margin-top: 1rem; flex-wrap: wrap; }
      .stat-item { font-size: 0.85rem; color: var(--text-muted); }
      .stat-item strong { color: var(--accent); }
      .stat-divider { width: 1px; background: var(--border); }
      .section { margin-bottom: 2.5rem; }
      .section-header { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 1rem; }
      .section-header h2 { font-size: 1.3rem; margin: 0; }
      .section-meta { font-size: 0.8rem; color: var(--text-muted); }
      .empty-state { color: var(--text-muted); font-size: 0.9rem; text-align: center; padding: 2rem 0; }
      .table-wrap { overflow-x: auto; }
      .lb-table { width: 100%; border-collapse: collapse; font-size: 0.8rem; }
      .lb-table th { text-align: left; padding: 0.5rem; border-bottom: 1px solid var(--border); color: var(--text-muted); font-weight: 500; }
      .lb-table td { padding: 0.5rem; border-bottom: 1px solid var(--border); }
      .th-center, .lb-center { text-align: center; }
      .th-num, .lb-num { text-align: right; }
      .lb-rank { font-size: 1rem; }
      .lb-model { font-weight: 600; }
      .lb-provider-badge { font-size: 0.7rem; padding: 0.15rem 0.4rem; border-radius: 4px; background: var(--accent-dim); color: var(--accent); }
      .lb-score { font-weight: 600; color: var(--accent); }
      .wins { color: #4ade80; font-weight: 600; }
      .losses { color: var(--text-muted); }
      .match-list { display: flex; flex-direction: column; gap: 0.5rem; }
      .match-card { border: 1px solid var(--border); border-radius: 8px; overflow: hidden; }
      .match-summary { display: flex; justify-content: space-between; align-items: center; padding: 0.75rem 1rem; cursor: pointer; list-style: none; }
      .match-summary::-webkit-details-marker { display: none; }
      .match-summary:hover { background: var(--accent-dim); }
      .match-summary-left { display: flex; align-items: center; gap: 0.5rem; flex: 1; min-width: 0; }
      .match-topic { font-weight: 500; font-size: 0.85rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
      .match-type-badge { font-size: 0.65rem; padding: 0.1rem 0.4rem; border-radius: 4px; background: var(--border); color: var(--text-muted); flex-shrink: 0; }
      .match-summary-right { display: flex; align-items: center; gap: 0.5rem; flex-shrink: 0; }
      .match-date { font-size: 0.75rem; color: var(--text-muted); }
      .match-winner-pill { font-size: 0.75rem; padding: 0.2rem 0.5rem; border-radius: 6px; font-weight: 500; }
      .winner-score { font-weight: 700; }
      .expand-arrow { color: var(--text-muted); font-size: 0.8rem; }
      .match-details { padding: 0.75rem 1rem; border-top: 1px solid var(--border); }
      .match-results { display: flex; flex-direction: column; gap: 0.4rem; }
      .result-row { display: flex; align-items: center; gap: 0.5rem; padding: 0.4rem 0.5rem; border-radius: 6px; }
      .result-winner { background: var(--accent-dim); }
      .result-emoji { font-size: 0.9rem; }
      .result-info { flex: 1; display: flex; align-items: center; gap: 0.4rem; }
      .result-model-name { font-weight: 500; font-size: 0.85rem; }
      .result-provider-tag { font-size: 0.65rem; padding: 0.1rem 0.3rem; border-radius: 3px; background: var(--border); color: var(--text-muted); }
      .result-score { font-weight: 600; font-size: 0.9rem; color: var(--accent); }
      .result-score-unit { font-size: 0.7rem; color: var(--text-muted); font-weight: 400; }
      .provider-grid { display: flex; flex-direction: column; gap: 0.75rem; }
      .provider-card { border: 1px solid var(--border); border-radius: 8px; padding: 0.75rem 1rem; }
      .provider-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem; }
      .provider-name { font-weight: 600; font-size: 0.9rem; }
      .provider-count { font-size: 0.75rem; color: var(--text-muted); }
      .provider-models { display: flex; flex-wrap: wrap; gap: 0.35rem; }
      .model-chip { font-size: 0.75rem; padding: 0.25rem 0.5rem; border-radius: 6px; background: var(--accent-dim); display: flex; align-items: center; gap: 0.3rem; }
      .mc-name { font-weight: 500; }
      .mc-role { font-size: 0.7rem; }
      .mc-status { font-size: 0.65rem; color: var(--text-muted); }
      .last-updated { text-align: center; font-size: 0.75rem; color: var(--text-muted); margin-top: 2rem; padding-top: 1rem; border-top: 1px solid var(--border); }
      @media (max-width: 768px) {
        .stats-bar { flex-wrap: wrap; gap: 0.2rem; }
        .stat-divider { display: none; }
        .match-summary { flex-direction: column; align-items: flex-start; }
        .match-summary-right { width: 100%; justify-content: space-between; }
        .provider-models { gap: 0.35rem; }
        .model-chip { font-size: 0.72rem; padding: 0.25rem 0.5rem; }
        .lb-table { font-size: 0.7rem; }
      }
    </style>
  </head>
  <body>
    <Header />
    <main class="arena">
      <section class="hero">
        <h1 class="hero-title">🏆 Arena</h1>
        <p class="hero-subtitle">Model vs model — cybersecurity content matches, automated judging.</p>
        <div class="stats-bar">
          <span class="stat-item"><strong>{totalMatches}</strong> Matches</span>
          <span class="stat-divider"></span>
          <span class="stat-item"><strong>{totalModels}</strong> Models</span>
          <span class="stat-divider"></span>
          <span class="stat-item"><strong>{totalProviders}</strong> Providers</span>
          <span class="stat-divider"></span>
          <span class="stat-item"><strong>{rankedModels}</strong> Ranked</span>
        </div>
      </section>

      <section class="section" id="leaderboard">
        <div class="section-header">
          <h2>Leaderboard</h2>
          <span class="section-meta">{sortedLeaderboard.length} model{sortedLeaderboard.length !== 1 ? 's' : ''}</span>
        </div>
        {sortedLeaderboard.length === 0 ? (
          <p class="empty-state">No ranked models yet. Matches will populate the leaderboard.</p>
        ) : (
          <div class="table-wrap">
            <table class="lb-table">
              <thead>
                <tr>
                  <th class="th-center">#</th>
                  <th>Model</th>
                  <th>Provider</th>
                  <th class="th-num">Avg</th>
                  <th class="th-center">W/L</th>
                  <th class="th-num">Best</th>
                </tr>
              </thead>
              <tbody>
                {sortedLeaderboard.map((m, i) => (
                  <tr class="lb-row">
                    <td class="lb-rank">{i < 3 ? rankEmojis[i] : `#${i + 1}`}</td>
                    <td class="lb-model">{m.model}</td>
                    <td class="lb-provider"><span class="lb-provider-badge">{m.provider || '—'}</span></td>
                    <td class="lb-score">{m.avgScore.toFixed(1)}</td>
                    <td class="lb-center"><span class="wins">{m.wins}</span><span class="losses">/{m.losses}</span></td>
                    <td class="lb-num">{m.bestScore.toFixed(1)}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}
      </section>

      <section class="section" id="matches">
        <div class="section-header">
          <h2>Match History</h2>
          <span class="section-meta">{sortedMatches.length} match{sortedMatches.length !== 1 ? 'es' : ''}</span>
        </div>
        {sortedMatches.length === 0 ? (
          <p class="empty-state">No matches yet. The arena awaits!</p>
        ) : (
          <div class="match-list">
            {sortedMatches.map(match => {
              const sortedResults = [...match.results].sort((a, b) => a.rank - b.rank);
              const winner = sortedResults[0];
              const winnerColor = winner.score >= 9 ? '#4ade80' : winner.score >= 7 ? '#ef4444' : '#f87171';
              return (
                <details class="match-card">
                  <summary class="match-summary">
                    <div class="match-summary-left">
                      <span class="match-topic">{match.topic}</span>
                      <span class="match-type-badge">{match.type}</span>
                    </div>
                    <div class="match-summary-right">
                      <span class="match-date">{match.date}</span>
                      <span class="match-winner-pill" style={`background: ${winnerColor}18; color: ${winnerColor};`}>
                        {winner.model} <span class="winner-score">{winner.score.toFixed(1)}</span>
                      </span>
                      <span class="expand-arrow" aria-hidden="true">▾</span>
                    </div>
                  </summary>
                  <div class="match-details">
                    <div class="match-results">
                      {sortedResults.map(r => (
                        <div class={`result-row ${r.rank === 1 ? 'result-winner' : ''}`}>
                          <span class="result-emoji">{r.rank === 1 ? '\u{1F947}' : r.rank === 2 ? '\u{1F948}' : '\u{1F949}'}</span>
                          <div class="result-info">
                            <span class="result-model-name">{r.model}</span>
                            <span class="result-provider-tag">{r.provider}</span>
                          </div>
                          <div class="result-score">{r.score != null ? r.score.toFixed(1) : '—'}<span class="result-score-unit">{r.score != null ? '/10' : ''}</span></div>
                        </div>
                      ))}
                    </div>
                  </div>
                </details>
              );
            })}
          </div>
        )}
      </section>

      {builderModels.length > 0 && (
      <section class="section" id="builder-models">
        <div class="section-header">
          <h2>Builder Models</h2>
          <span class="section-meta">{builderModels.length} model{builderModels.length !== 1 ? 's' : ''}</span>
        </div>
        <div class="provider-grid">
          {groupByProvider(builderModels).map(([provider, models]) => (
            <div class="provider-card">
              <div class="provider-header">
                <span class="provider-name">{provider}</span>
                <span class="provider-count">{models.length} model{models.length !== 1 ? 's' : ''}</span>
              </div>
              <div class="provider-models">
                {models.map(m => {
                  const stats = stability.model_stats[m.model] || { total_calls: 0, successes: 0, availability: 100 };
                  return (
                    <span class="model-chip" title={m.model}>
                      <span class="mc-name">{m.model}</span>
                      <span class="mc-role">🏗️</span>
                      <span class="mc-status">[{stats.availability.toFixed(0)}%]</span>
                    </span>
                  );
                })}
              </div>
            </div>
          ))}
        </div>
      </section>
      )}

      {judgeModels.length > 0 && (
      <section class="section" id="judge-models">
        <div class="section-header">
          <h2>Judge Models</h2>
          <span class="section-meta">{judgeModels.length} model{judgeModels.length !== 1 ? 's' : ''}</span>
        </div>
        <div class="provider-grid">
          {groupByProvider(judgeModels).map(([provider, models]) => (
            <div class="provider-card">
              <div class="provider-header">
                <span class="provider-name">{provider}</span>
                <span class="provider-count">{models.length} model{models.length !== 1 ? 's' : ''}</span>
              </div>
              <div class="provider-models">
                {models.map(m => {
                  const stats = stability.model_stats[m.model] || { total_calls: 0, successes: 0, availability: 100 };
                  return (
                    <span class="model-chip" title={m.model}>
                      <span class="mc-name">{m.model}</span>
                      <span class="mc-role">⚖️</span>
                      <span class="mc-status">[{stats.availability.toFixed(0)}%]</span>
                    </span>
                  );
                })}
              </div>
            </div>
          ))}
        </div>
      </section>
      )}

      <div class="last-updated">
        Last updated: {stability.last_updated || 'N/A'}
      </div>
    </main>
    <Footer />
  </body>
</html>
