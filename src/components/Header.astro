---
import { SITE_TITLE } from '../consts';
---

<header>
  <nav>
    <div class="nav-inner">
      <a href="/" class="site-logo">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
        </svg>
        <span><span class="brand">CyberSec</span><span class="brand-sub"> AI</span></span>
      </a>
      <div class="nav-links" data-menu-open>
        <a href="/scan/">Scanner</a>
        <a href="/headers/">Headers</a>
        <a href="/cves/">CVEs</a>
        <a href="/roadmap/">Roadmap</a>
        <a href="/blog/">Blog</a>
      </div>
      <button class="hamburger" data-hamburger aria-label="Toggle menu">
        <span class="hamburger-line"></span>
        <span class="hamburger-line"></span>
        <span class="hamburger-line"></span>
      </button>
      <button class="search-toggle" data-search-toggle aria-label="Toggle search" title="Search (Ctrl+K)">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="18" height="18">
          <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
        </svg>
      </button>
    </div>
  </nav>
  <div class="search-panel" data-search-panel>
    <div id="search"></div>
  </div>
</header>

<link href="/pagefind/pagefind-ui.css" rel="stylesheet" is:inline />
<script src="/pagefind/pagefind-ui.js" is:inline></script>

<style>
  header {
    position: sticky; top: 0; z-index: 100;
    background: rgba(13,17,23,0.85);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom: 1px solid var(--border-light);
    padding: 0 1em;
  }
  .nav-inner {
    width: 100%;
    max-width: 1100px;
    margin: 0 auto;
    display: flex; align-items: center; justify-content: flex-start;
  }
  @media (min-width: 1200px) {
    .nav-inner { max-width: 1240px; }
  }
  @media (min-width: 1440px) {
    .nav-inner { max-width: 1400px; }
  }
  @media (min-width: 1600px) {
    .nav-inner { max-width: 1440px; }
  }
  h2 { margin: 0; font-size: 1em; }
  .site-logo {
    display: flex; align-items: center; gap: 0.5em;
    text-decoration: none; padding: 0.85em 0;
  }
  .site-logo svg { flex-shrink: 0; }
  .site-logo .brand {
    font-weight: 700; font-size: 1.05em; letter-spacing: -0.02em;
    background: linear-gradient(135deg, #f0f6fc 40%, var(--accent));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  .site-logo .brand-sub {
    color: var(--accent); font-weight: 700; font-size: 1.05em; letter-spacing: -0.02em;
  }
  .site-logo:hover { opacity: 0.85; }
  .nav-links { display: flex; gap: 1.2em; align-items: center; margin-left: auto; }
  .nav-links a {
    color: rgb(var(--gray)); font-size: 0.85em; font-weight: 500;
    text-decoration: none; padding: 0.5em 0;
    border-bottom: 2px solid transparent; transition: color 0.15s, border-color 0.15s;
  }
  .nav-links a:hover { color: var(--accent); border-bottom-color: var(--accent); }

  /* ── Search Toggle (inline in nav) ── */
  .search-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border: 1px solid var(--border-light);
    border-radius: 6px;
    background: transparent;
    color: rgb(var(--gray));
    cursor: pointer;
    transition: all 0.15s ease;
    flex-shrink: 0;
    margin-left: 1em;
  }
  .search-toggle:hover {
    color: var(--accent);
    border-color: var(--accent);
    background: rgba(var(--accent-rgb, 88, 166, 255), 0.1);
  }

  /* ── Search Panel (below nav) ── */
  .search-panel {
    max-width: 1100px;
    margin: 0 auto;
    max-height: 0;
    overflow: hidden;
    opacity: 0;
    transition: max-height 0.25s ease, opacity 0.2s ease;
    padding: 0 0.75em;
  }
  .search-panel.open {
    max-height: 80vh;
    opacity: 1;
    padding-bottom: 1em;
  }
  @media (min-width: 1200px) {
    .search-panel { max-width: 1240px; }
  }
  @media (min-width: 1600px) {
    .search-panel { max-width: 1440px; }
  }

  /* ── Hamburger Mobile Menu ── */
  .hamburger {
    display: none;
    flex-direction: column;
    gap: 4px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 8px;
    margin-left: auto;
    flex-shrink: 0;
  }
  .hamburger-line {
    display: block;
    width: 20px;
    height: 2px;
    background: rgb(var(--gray));
    border-radius: 2px;
    transition: transform 0.3s, opacity 0.3s;
  }
  [data-hamburger].active .hamburger-line:nth-child(1) {
    transform: translateY(6px) rotate(45deg);
  }
  [data-hamburger].active .hamburger-line:nth-child(2) {
    opacity: 0;
  }
  [data-hamburger].active .hamburger-line:nth-child(3) {
    transform: translateY(-6px) rotate(-45deg);
  }

  @media (max-width: 768px) {
    .nav-links {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      background: rgba(13, 17, 23, 0.96);
      backdrop-filter: blur(18px);
      -webkit-backdrop-filter: blur(18px);
      flex-direction: column;
      padding: 0.5em 1em 1em;
      border-bottom: 1px solid var(--border-light);
      z-index: 99;
      gap: 0.25em;
      margin: 0;
    }
    .nav-links[data-menu-open] {
      display: flex;
    }
    .nav-links a {
      padding: 0.7em 0.75em;
      width: 100%;
      font-size: 0.9em;
    }
    .hamburger {
      display: flex;
    }
    .nav-inner {
      position: relative;
    }
  }

  #search { width: 100%; }
  .pagefind-ui__drawer { max-height: 70vh; overflow-y: auto; }
</style>

<script is:inline>
(function() {
  const toggle = document.querySelector('[data-search-toggle]');
  const panel = document.querySelector('[data-search-panel]');
  let pagefindInstance = null;

  function initPagefind() {
    if (typeof PagefindUI !== 'undefined' && !pagefindInstance) {
      pagefindInstance = new PagefindUI({ element: '#search', showImages: false, showSubResults: true });
    }
  }

  function openSearch() {
    if (!panel || panel.classList.contains('open')) return;
    panel.classList.add('open');
    initPagefind();
    setTimeout(() => {
      panel.querySelector('input')?.focus();
    }, 150);
  }

  function closeSearch() {
    if (!panel) return;
    panel.classList.remove('open');
  }

  function toggleSearch() {
    if (panel?.classList.contains('open')) {
      closeSearch();
    } else {
      openSearch();
    }
  }

  toggle?.addEventListener('click', toggleSearch);

  /* ── Hamburger menu toggle ── */
  const hamburger = document.querySelector('[data-hamburger]');
  hamburger?.addEventListener('click', function() {
    const menu = document.querySelector('[data-menu-open]');
    if (menu) {
      const isOpen = menu.hasAttribute('data-menu-open');
      if (isOpen) {
        menu.removeAttribute('data-menu-open');
      } else {
        menu.setAttribute('data-menu-open', '');
      }
      this.classList.toggle('active');
    }
  });

  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeSearch(); });
  document.addEventListener('keydown', (e) => {
    if ((e.ctrlKey || e.metaKey) && e.key === 'k') { e.preventDefault(); openSearch(); }
  });
  document.addEventListener('click', (e) => {
    if (panel?.classList.contains('open') && !panel.contains(e.target) && toggle && !toggle.contains(e.target)) {
      closeSearch();
    }
  });
})();
</script>
