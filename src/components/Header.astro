---
import { SITE_TITLE } from '../consts';
---

<header>
  <nav>
    <a href="/" class="logo">{SITE_TITLE}</a>
    <div class="nav-links">
      <a href="/blog">Reviews</a>
      <a href="/blog">Tutorials</a>
      <a href="/blog">Comparisons</a>
    </div>
  </nav>
</header>
<style>
  header {
    position: sticky;
    top: 0;
    background: rgba(13,13,18,0.85);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom: 1px solid var(--border-light);
    z-index: 100;
    padding: 0 1em;
  }
  nav {
    max-width: 1100px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 56px;
  }
  .logo {
    text-decoration: none;
    color: #f0f6fc;
    font-weight: 700;
    font-size: 1em;
    letter-spacing: -0.02em;
    transition: color 0.2s;
  }
  .logo:hover { color: var(--accent); }
  .nav-links {
    display: flex;
    gap: 1.5em;
  }
  .nav-links a {
    text-decoration: none;
    color: rgb(var(--gray));
    font-size: 0.88em;
    font-weight: 450;
    transition: color 0.2s;
  }
  .nav-links a:hover { color: #f0f6fc; }
  @media (max-width: 480px) {
    .nav-links { display: none; }
  }
</style>
