---
// Network attack visualization — interactive canvas animation
// No dependencies, pure Canvas 2D.
---

<canvas id="attackViz" aria-label="Network security visualization"></canvas>

<style>
  #attackViz {
    width: 100%;
    height: 320px;
    display: block;
    border-radius: 14px;
    background: #0d0d12;
    border: 1px solid #23232e;
    cursor: default;
  }
  @media (min-width: 1200px) {
    #attackViz { height: 380px; }
  }
  @media (max-width: 640px) {
    #attackViz { height: 260px; border-radius: 10px; }
  }
</style>

<script is:inline>
(function() {
  const canvas = document.getElementById('attackViz');
  if (!canvas) return;

  const ctx = canvas.getContext('2d');
  let w, h, dpr = 2;

  function resize() {
    const rect = canvas.getBoundingClientRect();
    w = rect.width;
    h = rect.height;
    canvas.width = w * dpr;
    canvas.height = h * dpr;
    ctx.scale(dpr, dpr);
  }
  resize();
  window.addEventListener('resize', resize);

  // ── Network nodes ──
  const nodes = [
    { x: 0.5, y: 0.12, label: 'DNS',   r: 24, status: 'warning' },
    { x: 0.17, y: 0.38, label: 'CDN',    r: 20, status: 'secure' },
    { x: 0.83, y: 0.38, label: 'CDN',    r: 20, status: 'warning' },
    { x: 0.5,  y: 0.5,  label: 'WAF / LB', r: 22, status: 'secure' },
    { x: 0.28, y: 0.68, label: 'Web',   r: 18, status: 'compromised' },
    { x: 0.72, y: 0.68, label: 'Web',   r: 18, status: 'secure' },
    { x: 0.4,  y: 0.85, label: 'API',   r: 16, status: 'warning' },
    { x: 0.6,  y: 0.85, label: 'DB',    r: 16, status: 'secure' },
  ];

  const statusColors = {
    secure: { fill: '#22c55e', stroke: '#22c55e44', glow: 'rgba(34,197,94,0.15)' },
    warning: { fill: '#eab308', stroke: '#eab30844', glow: 'rgba(234,179,8,0.15)' },
    compromised: { fill: '#ef4444', stroke: '#ef444444', glow: 'rgba(239,68,68,0.2)' },
  };

  // ── Edges (connections between nodes) ──
  const edges = [
    [0, 1], [0, 2],        // DNS → CDNs
    [1, 3], [2, 3],        // CDNs → LB
    [3, 4], [3, 5],        // LB → Web servers
    [4, 6], [5, 6],        // Web → API
    [6, 7],                // API → DB
    [4, 7], [5, 7],        // Web → DB (direct)
  ];

  // ── Attack particles ──
  const particles = [];
  const MAX_PARTICLES = 30;
  const ATTACK_PATHS = [
    [0, 2, 'warning'],   // DNS → CDN (west)
    [2, 3, 'warning'],   // CDN → LB
    [3, 4, 'compromised'], // LB → Web (west - breached!)
    [1, 3, 'secure'],    // CDN → LB (clean)
    [4, 6, 'compromised'], // Web → API (breach spreading)
    [6, 7, 'compromised'], // API → DB (critical!)
    [5, 7, 'secure'],    // Web → DB (clean)
  ];

  function spawnParticle() {
    if (particles.length >= MAX_PARTICLES) return;
    // Pick a random attack path based on severity weight
    const weighted = ATTACK_PATHS.flatMap(p => {
      const w = p[2] === 'compromised' ? 3 : p[2] === 'warning' ? 2 : 1;
      return Array(w).fill(p);
    });
    const path = weighted[Math.floor(Math.random() * weighted.length)];
    const [si, ei, status] = path;
    const s = nodes[si], e = nodes[ei];
    // Convert relative to absolute
    const sx = s.x * w, sy = s.y * h;
    const ex = e.x * w, ey = e.y * h;
    particles.push({
      x: sx, y: sy, sx, sy, ex, ey,
      progress: 0,
      speed: 0.004 + Math.random() * 0.006,
      status,
      wave: Math.random() * Math.PI * 2,
      size: 2.5 + Math.random() * 2,
    });
  }

  let mouseX = -1, mouseY = -1;
  let hoveredNode = -1;

  canvas.addEventListener('mousemove', (e) => {
    const rect = canvas.getBoundingClientRect();
    mouseX = e.clientX - rect.left;
    mouseY = e.clientY - rect.top;
    hoveredNode = -1;
    for (let i = 0; i < nodes.length; i++) {
      const n = nodes[i];
      const nx = n.x * w, ny = n.y * h;
      const dx = mouseX - nx, dy = mouseY - ny;
      if (dx*dx + dy*dy < (n.r + 8) * (n.r + 8)) {
        hoveredNode = i;
        break;
      }
    }
    canvas.style.cursor = hoveredNode >= 0 ? 'pointer' : 'default';
  });

  canvas.addEventListener('mouseleave', () => { mouseX = -1; hoveredNode = -1; });

  // ── Animation loop ──
  let time = 0;
  let spawnTimer = 0;

  function draw() {
    time += 0.016;
    spawnTimer += 0.016;

    // Spawn particles periodically
    if (spawnTimer > 0.4) {
      spawnParticle();
      spawnTimer = 0;
    }

    ctx.clearRect(0, 0, w, h);

    // ── Grid dots ──
    ctx.fillStyle = 'rgba(255,255,255,0.03)';
    for (let x = 0; x < w; x += 40) {
      for (let y = 0; y < h; y += 40) {
        ctx.beginPath();
        ctx.arc(x, y, 1, 0, Math.PI * 2);
        ctx.fill();
      }
    }

    // ── Edges ──
    for (const [si, ei] of edges) {
      const s = nodes[si], e = nodes[ei];
      const sx = s.x * w, sy = s.y * h;
      const ex = e.x * w, ey = e.y * h;

      // Gradient line
      const grad = ctx.createLinearGradient(sx, sy, ex, ey);
      const sc = statusColors[s.status]?.glow || 'rgba(255,255,255,0.05)';
      const ec = statusColors[e.status]?.glow || 'rgba(255,255,255,0.05)';
      grad.addColorStop(0, sc);
      grad.addColorStop(1, ec);
      ctx.strokeStyle = grad;
      ctx.lineWidth = 1.5;
      ctx.beginPath();
      ctx.moveTo(sx, sy);
      ctx.lineTo(ex, ey);
      ctx.stroke();
    }

    // ── Attack particles ──
    for (let i = particles.length - 1; i >= 0; i--) {
      const p = particles[i];
      p.progress += p.speed;
      if (p.progress > 1) { particles.splice(i, 1); continue; }

      const t = p.progress;
      const x = p.sx + (p.ex - p.sx) * t;
      const y = p.sy + (p.ey - p.sy) * t + Math.sin(p.wave + t * 8) * 3;

      const col = statusColors[p.status];
      const alpha = t < 0.1 ? t * 10 : t > 0.9 ? (1 - t) * 10 : 1;

      // Glow
      ctx.shadowColor = col.fill;
      ctx.shadowBlur = 10;
      ctx.fillStyle = col.fill;
      ctx.globalAlpha = alpha * 0.4;
      ctx.beginPath();
      ctx.arc(x, y, p.size * 1.8, 0, Math.PI * 2);
      ctx.fill();

      // Core
      ctx.shadowBlur = 0;
      ctx.globalAlpha = alpha;
      ctx.fillStyle = '#ffffff';
      ctx.beginPath();
      ctx.arc(x, y, p.size * 0.6, 0, Math.PI * 2);
      ctx.fill();

      ctx.globalAlpha = 1;
    }

    // ── Nodes ──
    for (let i = 0; i < nodes.length; i++) {
      const n = nodes[i];
      const nx = n.x * w, ny = n.y * h;
      const sc = statusColors[n.status];
      const isHover = hoveredNode === i;
      const pulse = Math.sin(time * 2 + i * 1.2) * 0.15 + 1;

      // Outer glow ring (pulses for compromised nodes)
      if (n.status === 'compromised') {
        ctx.shadowColor = sc.fill;
        ctx.shadowBlur = 25;
        ctx.strokeStyle = sc.fill;
        ctx.globalAlpha = 0.15 * pulse;
        ctx.lineWidth = 2;
        ctx.beginPath();
        ctx.arc(nx, ny, n.r * 1.5 * pulse, 0, Math.PI * 2);
        ctx.stroke();
        ctx.shadowBlur = 0;
        ctx.globalAlpha = 1;
      }

      // Node fill
      const grad = ctx.createRadialGradient(nx - n.r*0.3, ny - n.r*0.3, 0, nx, ny, n.r);
      grad.addColorStop(0, isHover ? '#ffffff' : '#1a1a23');
      grad.addColorStop(0.5, '#14141b');
      grad.addColorStop(1, '#0d0d12');
      ctx.fillStyle = grad;
      ctx.strokeStyle = sc.stroke;
      ctx.lineWidth = isHover ? 2.5 : 1.5;
      ctx.beginPath();
      ctx.arc(nx, ny, n.r, 0, Math.PI * 2);
      ctx.fill();
      ctx.stroke();

      // Status dot on node
      ctx.shadowColor = sc.fill;
      ctx.shadowBlur = n.status === 'compromised' ? 12 : 6;
      ctx.fillStyle = sc.fill;
      ctx.beginPath();
      ctx.arc(nx, ny, isHover ? 6 : 4, 0, Math.PI * 2);
      ctx.fill();
      ctx.shadowBlur = 0;

      // Label
      ctx.fillStyle = isHover ? '#ffffff' : '#a0a0b0';
      ctx.font = isHover ? 'bold 10px Inter, sans-serif' : '9px Inter, sans-serif';
      ctx.textAlign = 'center';
      ctx.fillText(n.label, nx, ny + n.r + 14);
    }

    // ── Tooltip ──
    if (hoveredNode >= 0) {
      const n = nodes[hoveredNode];
      const nx = n.x * w, ny = n.y * h;
      const statusLabel = n.status === 'secure' ? '✓ Secure'
        : n.status === 'warning' ? '⚠ Warning'
        : '✗ Compromised';
      const statusColor = n.status === 'secure' ? '#22c55e'
        : n.status === 'warning' ? '#eab308'
        : '#ef4444';

      // Tooltip box
      const tw = 120, th = 48;
      const tx = Math.max(10, Math.min(nx - tw/2, w - tw - 10));
      const ty = ny - n.r - 52;

      ctx.fillStyle = 'rgba(20,20,27,0.92)';
      ctx.strokeStyle = '#23232e';
      ctx.lineWidth = 1;
      roundRect(ctx, tx, ty, tw, th, 8);
      ctx.fill();
      ctx.stroke();

      ctx.fillStyle = '#e8e8ed';
      ctx.font = 'bold 11px Inter, sans-serif';
      ctx.textAlign = 'left';
      ctx.fillText(n.label, tx + 12, ty + 18);

      ctx.fillStyle = statusColor;
      ctx.font = '10px Inter, sans-serif';
      ctx.fillText(statusLabel, tx + 12, ty + 36);
    }

    // ── Live attack counter ──
    const compromised = nodes.filter(n => n.status === 'compromised').length;
    const warnings = nodes.filter(n => n.status === 'warning').length;

    ctx.fillStyle = '#6b6b7b';
    ctx.font = '10px Inter, sans-serif';
    ctx.textAlign = 'left';
    ctx.fillText('Live topology · ' + nodes.length + ' nodes', 12, 16);

    ctx.textAlign = 'right';
    ctx.fillStyle = '#ef4444';
    ctx.font = 'bold 10px Inter, sans-serif';
    ctx.fillText(compromised + ' breached', w - 12, 16);

    if (warnings > 0) {
      ctx.fillStyle = '#eab308';
      ctx.fillText(warnings + ' warnings  ', w - 75, 16);
    }

    requestAnimationFrame(draw);
  }

  function roundRect(ctx, x, y, w, h, r) {
    ctx.beginPath();
    ctx.moveTo(x + r, y);
    ctx.lineTo(x + w - r, y);
    ctx.quadraticCurveTo(x + w, y, x + w, y + r);
    ctx.lineTo(x + w, y + h - r);
    ctx.quadraticCurveTo(x + w, y + h, x + w - r, y + h);
    ctx.lineTo(x + r, y + h);
    ctx.quadraticCurveTo(x, y + h, x, y + h - r);
    ctx.lineTo(x, y + r);
    ctx.quadraticCurveTo(x, y, x + r, y);
    ctx.closePath();
  }

  draw();
})();
</script>
