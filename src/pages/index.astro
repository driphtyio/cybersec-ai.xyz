---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { getCollection } from 'astro:content';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const allPosts = await getCollection('blog');
allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const latest = allPosts[0];
const remaining = allPosts.slice(1);

const categories = ['Review', 'Comparison', 'Tutorial', 'n8n', 'AI Agents', 'Automation'];
const catSlugs = ['review', 'comparison', 'tutorial', 'n8n', 'ai-agents', 'automation'];
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Header />

    <main>
      <!-- Intro -->
      <section class="intro">
        <h1>{SITE_TITLE}</h1>
        <p class="tagline">{SITE_DESCRIPTION}</p>
        <div class="topics">
          {categories.map((label, i) => (
            <a href={`/blog#tag-${catSlugs[i]}`} class="topic">{label}</a>
          ))}
        </div>
      </section>

      <!-- Featured post -->
      {latest && (
        <section class="featured">
          <span class="section-label">Latest</span>
          <a href={`/blog/${latest.id}/`} class="f-card">
            {latest.data.heroImage && (
              <img src={latest.data.heroImage} alt="" class="f-img" loading="eager" />
            )}
            <div class="f-body">
              <div class="f-meta">
                <time datetime={latest.data.pubDate.toISOString()}>
                  {latest.data.pubDate.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}
                </time>
                {latest.data.tags?.slice(0, 2).map(t => (
                  <span class="f-tag">{t}</span>
                ))}
              </div>
              <h2>{latest.data.title}</h2>
              <p>{latest.data.description}</p>
            </div>
          </a>
        </section>
      )}

      <!-- Recent posts -->
      <section class="recent">
        <span class="section-label">Recent posts</span>
        <div class="post-list">
          {remaining.slice(0, 10).map((post, i) => (
            <article class="post">
              <a href={`/blog/${post.id}/`} class="post-link">
                {post.data.heroImage && (
                  <div class="post-img-wrap">
                    <img src={post.data.heroImage} alt="" class="post-img" loading={i < 3 ? 'eager' : 'lazy'} />
                  </div>
                )}
                <div class="post-body">
                  <div class="post-meta">
                    <time datetime={post.data.pubDate.toISOString()}>
                      {post.data.pubDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
                    </time>
                    {post.data.tags?.slice(0, 1).map(t => (
                      <span class="post-tag">{t}</span>
                    ))}
                  </div>
                  <h3 class="post-title">{post.data.title}</h3>
                  <p class="post-desc">{post.data.description}</p>
                </div>
              </a>
            </article>
          ))}
        </div>
      </section>

      <!-- All posts link -->
      <div class="more">
        <a href="/blog" class="more-link">Browse all posts<span class="more-arrow">→</span></a>
      </div>
    </main>

    <Footer />
  </body>
</html>

<style is:global>
  /* ─── Intro ─── */
  .intro {
    margin-bottom: 56px;
    padding-top: 16px;
  }
  .intro h1 {
    font-size: clamp(1.75rem, 4vw, 2.25rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    margin: 0 0 10px;
    color: #e8edf4;
  }
  .tagline {
    font-size: 0.95rem;
    color: rgb(var(--gray));
    line-height: 1.65;
    margin: 0 0 18px;
    max-width: 540px;
  }
  .topics {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 10px;
  }
  .topic {
    font-size: 0.82rem;
    color: var(--accent);
    text-decoration: none;
    padding: 2px 0;
    border-bottom: 1px solid transparent;
    transition: border-color 0.2s;
  }
  .topic:hover { border-color: var(--accent); }

  /* ─── Section label ─── */
  .section-label {
    display: block;
    font-size: 0.72rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: rgb(var(--gray));
    margin-bottom: 20px;
  }

  /* ─── Featured post ─── */
  .featured {
    margin-bottom: 56px;
  }
  .f-card {
    display: block;
    background: var(--bg-card);
    border: 1px solid var(--border-light);
    border-radius: 14px;
    overflow: hidden;
    text-decoration: none;
    transition: border-color 0.3s, box-shadow 0.3s;
  }
  .f-card:hover {
    border-color: var(--accent);
    box-shadow: 0 8px 24px rgba(0,0,0,0.2);
  }
  .f-img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    display: block;
    border-bottom: 1px solid var(--border-light);
  }
  .f-body {
    padding: 20px 24px 24px;
  }
  .f-meta {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 0.78rem;
    color: rgb(var(--gray));
    margin-bottom: 10px;
  }
  .f-tag {
    font-size: 0.72rem;
    color: var(--accent);
    opacity: 0.75;
  }
  .f-body h2 {
    font-size: 1.35rem;
    font-weight: 650;
    line-height: 1.3;
    margin: 0 0 8px;
    color: #e8edf4;
    transition: color 0.25s;
  }
  .f-card:hover h2 { color: var(--accent); }
  .f-body p {
    font-size: 0.9rem;
    color: rgb(var(--gray));
    line-height: 1.55;
    margin: 0;
  }

  /* ─── Recent post list ─── */
  .recent {
    margin-bottom: 40px;
  }
  .post-list {
    display: flex;
    flex-direction: column;
    gap: 1px;
    background: var(--border-light);
    border: 1px solid var(--border-light);
    border-radius: 14px;
    overflow: hidden;
  }
  .post-link {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: 0;
    text-decoration: none;
    transition: background 0.2s;
    background: var(--bg);
  }
  .post-link:hover {
    background: var(--bg-card);
  }
  .post-img-wrap {
    overflow: hidden;
    position: relative;
  }
  .post-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.3s, opacity 0.3s;
  }
  .post-link:hover .post-img {
    transform: scale(1.04);
    opacity: 0.9;
  }
  .post-body {
    padding: 20px 24px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .post-meta {
    font-size: 0.75rem;
    color: rgb(var(--gray));
    margin-bottom: 6px;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .post-tag {
    font-size: 0.7rem;
    font-weight: 500;
    color: var(--accent);
    opacity: 0.7;
    transition: opacity 0.2s;
  }
  .post-link:hover .post-tag { opacity: 1; }
  .post-title {
    font-size: 1.05rem;
    font-weight: 600;
    line-height: 1.3;
    margin: 0 0 6px;
    color: #e8edf4;
    transition: color 0.2s;
  }
  .post-link:hover .post-title { color: var(--accent); }
  .post-desc {
    font-size: 0.85rem;
    color: rgb(var(--gray));
    line-height: 1.5;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* ─── More link ─── */
  .more {
    text-align: center;
    margin-bottom: 56px;
  }
  .more-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.9rem;
    color: var(--accent);
    text-decoration: none;
    padding: 12px 24px;
    border: 1px solid var(--border-light);
    border-radius: 10px;
    transition: border-color 0.25s, background 0.25s;
    font-weight: 500;
  }
  .more-link:hover {
    border-color: var(--accent);
  }
  .more-arrow {
    display: inline-block;
    transition: transform 0.25s;
  }
  .more-link:hover .more-arrow { transform: translateX(4px); }

  /* ─── Responsive: Tablet ─── */
  @media (max-width: 768px) {
    .post-link {
      grid-template-columns: 1fr;
    }
    .post-img-wrap {
      aspect-ratio: 16 / 9;
      max-height: 180px;
    }
    .post-img {
      aspect-ratio: 16 / 9;
    }
    .post-body {
      padding: 16px 18px;
    }
    .f-body {
      padding: 16px 18px 20px;
    }
    .f-body h2 {
      font-size: 1.2rem;
    }
  }

  /* ─── Responsive: Mobile ─── */
  @media (max-width: 480px) {
    .intro { margin-bottom: 40px; }
    .featured { margin-bottom: 40px; }
    .post-body { padding: 14px 16px; }
    .post-title { font-size: 1rem; }
    .post-desc { font-size: 0.82rem; }
    .f-body { padding: 14px 16px 18px; }
    .f-body h2 { font-size: 1.1rem; }
    .more-link { width: 100%; justify-content: center; }
  }
</style>
