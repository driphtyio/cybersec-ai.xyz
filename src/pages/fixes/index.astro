---
<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title="PR Bug Fix Database \u2014 Search &amp; Browse"
      description="Search and browse PR bug fixes from open source projects. Filter by severity, repo, and keywords."
    />
    <style>
      .cv-page { max-width: 1200px; margin: 0 auto; padding: 2rem 1.5rem; }
      .cv-header { margin-bottom: 1.5rem; }
      .cv-header h1 { margin: 0 0 0.3rem; }
      .cv-header .sub { margin: 0; color: var(--ink-muted, #a0a0b0); font-size: 0.9rem; }
      .cv-header .count { display: inline-block; margin-top: 0.5rem; font-size: 0.75rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; color: var(--accent, #00d4aa); background: rgba(0,212,170,0.08); padding: 0.2rem 0.6rem; border-radius: 4px; }
      .search-row { margin-bottom: 1rem; }
      .search-row input {
        width: 100%; padding: 0.7rem 1rem; border: 1px solid var(--border, #2d3b4e);
        border-radius: 8px; background: var(--bg-card, #161b22); color: #e8edf4;
        font-size: 0.95rem; outline: none; box-sizing: border-box;
      }
      .search-row input:focus { border-color: var(--accent, #00d4aa); }
      .filters { display: flex; gap: 0.4rem; margin-bottom: 1rem; flex-wrap: wrap; }
      .pill {
        padding: 0.35rem 1rem; border: 1px solid var(--border, #2d3b4e); border-radius: 20px;
        background: transparent; color: var(--ink-muted, #a0a0b0); cursor: pointer;
        font-size: 0.82rem; font-weight: 500; transition: all 0.15s;
      }
      .pill:hover { border-color: var(--accent, #00d4aa); color: var(--accent, #00d4aa); }
      .pill.active { background: var(--accent, #00d4aa); color: #0d1117; border-color: var(--accent, #00d4aa); font-weight: 600; }
      .statline { font-size: 0.8rem; color: var(--ink-muted, #a0a0b0); margin-bottom: 0.8rem; }
      .cv-table { width: 100%; border-collapse: collapse; font-size: 0.85rem; }
      .cv-table thead th {
        text-align: left; padding: 0.6rem 0.8rem; font-size: 0.75rem; font-weight: 600;
        text-transform: uppercase; letter-spacing: 0.04em;
        color: var(--ink-tertiary, #4a4a58); background: var(--surface-2, #1a1a23);
        border-bottom: 1px solid var(--border, #2d3b4e); white-space: nowrap;
      }
      .cv-table tbody tr { cursor: pointer; transition: background 0.12s; }
      .cv-table tbody tr:hover { background: rgba(0,212,170,0.04); }
      .cv-table tbody td { padding: 0.6rem 0.8rem; border-bottom: 1px solid var(--border-light, #1e2a3a); vertical-align: top; }
      .cve-link { color: var(--accent, #00d4aa); font-weight: 600; text-decoration: none; font-size: 0.82rem; font-family: 'JetBrains Mono', monospace; word-break: break-all; }
      .cve-link:hover { text-decoration: underline; }
      .col-id { width: 14%; }
      .col-score { width: 7%; text-align: center; }
      .col-sev { width: 9%; }
      .col-desc { }
      .col-repo { width: 12%; }
      .col-scope { width: 9%; }
      .col-tags { width: 13%; }
      .col-date { width: 9%; }
      .score-badge { font-weight: 700; font-size: 1rem; }
      .sev-badge {
        display: inline-block; padding: 0.15rem 0.5rem; border-radius: 4px;
        font-size: 0.72rem; font-weight: 600; color: #fff;
      }
      .sev-critical { background: #ef4444; }
      .sev-high { background: #f97316; }
      .sev-medium { background: #eab308; color: #0d1117; }
      .sev-low { background: #22c55e; }
      .badge-tag {
        display: inline-block; margin: 0.15rem 0.3rem; padding: 0.1rem 0.4rem;
        border-radius: 3px; font-size: 0.7rem; font-weight: 500;
        background: rgba(0,212,170,0.08); color: var(--ink-muted, #a0a0b0);
        cursor: pointer;
      }
      .badge-tag:hover { background: rgba(0,212,170,0.15); color: var(--accent, #00d4aa); }
      .pg { display: flex; justify-content: center; align-items: center; gap: 0.3rem; margin-top: 1.5rem; flex-wrap: wrap; }
      .pg button {
        padding: 0.35rem 0.7rem; border: 1px solid var(--border, #2d3b4e); border-radius: 5px;
        background: transparent; color: var(--ink-muted, #a0a0b0); cursor: pointer; font-size: 0.82rem;
      }
      .pg button:hover { border-color: var(--accent, #00d4aa); color: var(--accent, #00d4aa); }
      .pg button.active { background: var(--accent, #00d4aa); color: #0d1117; font-weight: 600; border-color: var(--accent, #00d4aa); }
      .pg button:disabled { opacity: 0.4; cursor: default; }
      .no-results { text-align: center; padding: 3rem; color: var(--ink-muted, #a0a0b0); }
      @media (max-width: 720px) {
        .cv-page { padding: 1rem; }
        .cv-table { font-size: 0.78rem; }
        .col-tags, .col-repo, .col-scope { display: none; }
        .col-score { width: 10%; }
        .col-sev { width: 12%; }
      }
    </style>
  </head>
  <body>
    <Header />
    <main class="cv-page">
      <div class="cv-header">
        <h1>PR Bug Fix Database</h1>
        <p class="sub">Browse real PR bug fixes from open source projects. Each fix includes root cause analysis, diff, and actionable patterns.</p>
        <span class="count" id="countDisplay">23 indexed</span>
      </div>
      <div class="search-row">
        <input type="text" id="si" placeholder="Search Fix ID, repo, title, or keyword…" autocomplete="off" />
      </div>
      <div class="filters" id="filters">
        <button class="pill active" data-f="all">All</button>
        <button class="pill" data-f="critical">🔴 Critical</button>
        <button class="pill" data-f="high">🟠 High</button>
        <button class="pill" data-f="medium">🟡 Medium</button>
        <button class="pill" data-f="low">🟢 Low</button>
      </div>
      <div class="statline" id="statline">Loading…</div>
      <table class="cv-table">
        <thead>
          <tr>
            <th class="col-id">Fix ID</th>
            <th class="col-score">Score</th>
            <th class="col-sev">Severity</th>
            <th class="col-desc">Title</th>
            <th class="col-repo">Repo</th>
            <th class="col-scope">Lines</th>
            <th class="col-tags">Tags</th>
            <th class="col-date">Date</th>
          </tr>
        </thead>
        <tbody id="tbody"></tbody>
      </table>
      <div id="empty" class="no-results" style="display:none"></div>
      <div class="pg" id="pg"></div>
    </main>
    <script>
      (function() {
        const ALL = FIXES_DATA;
        let filtered = []; var page = 1; let filter = 'all';
        const PAGE = 25;
        const el = function(id) { return document.getElementById(id); };
        const tbody = el('tbody'), statline = el('statline'), empty = el('empty'), pgEl = el('pg'), si = el('si'), countDisplay = el('countDisplay');

        function sevColor(s) {
          return s === 'critical' ? '#ef4444' : s === 'high' ? '#f97316' : s === 'medium' ? '#eab308' : '#22c55e';
        }

        countDisplay.textContent = ALL.length + ' indexed';

        tbody.addEventListener('click', function(e) {
          var tag = e.target.closest('.badge-tag');
          if (tag) {
            e.stopPropagation();
            e.preventDefault();
            si.value = tag.textContent.trim();
            page = 1;
            apply();
          }
        });

        pgEl.addEventListener('click', function(e) {
          var btn = e.target.closest('button[data-page]');
          if (btn && !btn.disabled) {
            page = parseInt(btn.dataset.page);
            render();
          }
        });

        var dynStyle = document.createElement('style');
        dynStyle.textContent = '.badge-tag:hover{background:rgba(0,212,170,0.15)!important;color:var(--accent,#00d4aa)!important}';
        document.head.appendChild(dynStyle);

        var params = new URLSearchParams(window.location.search);
        var qParam = params.get('q');
        if (qParam) { si.value = qParam; }
        apply();

        el('filters').addEventListener('click', function(e) {
          var btn = e.target.closest('.pill');
          if (!btn) return;
          document.querySelectorAll('.pill').forEach(function(p) { p.classList.remove('active'); });
          btn.classList.add('active');
          filter = btn.dataset.f;
          page = 1;
          apply();
        });

        // Click delegation for fix rows
        tbody.addEventListener('click', function(e) {
          var row = e.target.closest('.fix-row');
          if (row && row.dataset.href) {
            window.location.href = row.dataset.href;
          }
        });

        si.addEventListener('input', function() { page = 1; apply(); });

        function apply() {
          var q = si.value.toLowerCase().trim();
          var f = ALL;
          if (filter === 'critical') f = f.filter(function(c) { return c.severity === 'critical'; });
          else if (filter === 'high') f = f.filter(function(c) { return c.severity === 'high'; });
          else if (filter === 'medium') f = f.filter(function(c) { return c.severity === 'medium'; });
          else if (filter === 'low') f = f.filter(function(c) { return c.severity === 'low'; });
          if (q) {
            f = f.filter(function(c) {
              return (c.id && c.id.toLowerCase().indexOf(q) !== -1) ||
                     (c.title && c.title.toLowerCase().indexOf(q) !== -1) ||
                     (c.repo && c.repo.toLowerCase().indexOf(q) !== -1) ||
                     (c.description && c.description.toLowerCase().indexOf(q) !== -1) ||
                     (c.tags && c.tags.some(function(t) { return t.toLowerCase().indexOf(q) !== -1; }));
            });
          }
          filtered = f;
          page = Math.min(page, Math.ceil(filtered.length / PAGE) || 1);
          render();
        }

        function render() {
          var total = filtered.length;
          var pages = Math.ceil(total / PAGE) || 1;
          var start = (page - 1) * PAGE;
          var items = filtered.slice(start, start + PAGE);

          statline.textContent = total > 0
            ? total + ' result' + (total !== 1 ? 's' : '') + ' — showing ' + (start+1) + '–' + Math.min(start+PAGE, total)
            : 'No results';

          if (items.length === 0) {
            tbody.innerHTML = '';
            empty.style.display = 'block';
            empty.innerHTML = '🔍 No fixes match your search. Try different keywords or clear the filter.';
            pgEl.innerHTML = '';
            return;
          }
          empty.style.display = 'none';

          tbody.innerHTML = items.map(function(c) {
            var tags = c.tags || [];
            var emoji = c.severity === 'critical' ? '🔴' : c.severity === 'high' ? '🟠' : c.severity === 'medium' ? '🟡' : '🟢';
            return '<tr data-href="/fixes/' + c.id + '/" class="fix-row">' +
              '<td><a href="/fixes/' + c.id + '/" class="cve-link">' + c.id + '</a></td>' +
              '<td style="text-align:center"><span class="score-badge" style="color:' + sevColor(c.severity) + '">' + c.compoundScore.toFixed(1) + '</span></td>' +
              '<td><span class="sev-badge sev-' + c.severity + '">' + emoji + ' ' + c.severity_label + '</span></td>' +
              '<td style="color:var(--ink-muted,#a0a0b0);font-size:0.8rem;line-height:1.4">' +
                (c.title.length > 100 ? c.title.slice(0, 100) + '…' : c.title) + '</td>' +
              '<td class="col-repo" style="font-size:0.75rem;color:var(--ink-muted,#a0a0b0);font-family:monospace">' + c.repo + '</td>' +
              '<td class="col-scope" style="text-align:center;font-size:0.78rem;color:var(--ink-muted,#a0a0b0)">' + c.fix_scope + '</td>' +
              '<td class="col-tags">' + (tags.length ? tags.map(function(t) { return '<span class="badge-tag">' + t + '</span>'; }).join('') : '') + '</td>' +
              '<td class="col-date" style="font-size:0.75rem;color:var(--ink-muted,#a0a0b0);white-space:nowrap">' + (c.pubDate || '') + '</td>' +
              '</tr>';
          }).join('');

          var phtml = '';
          phtml += '<button data-page="1" ' + (page === 1 ? 'disabled' : '') + '>«</button>';
          for (var i = Math.max(1, page - 3); i <= Math.min(pages, page + 3); i++) {
            var isActive = i === page;
            phtml += '<button data-page="' + i + '" class="' + (isActive ? 'active' : '') + '" style="' + (isActive ? 'background:var(--accent,#00d4aa);color:#0d1117;font-weight:600;border-color:var(--accent,#00d4aa)' : '') + '">' + i + '</button>';
          }
          phtml += '<button data-page="' + pages + '" ' + (page === pages ? 'disabled' : '') + '>»</button>';
          pgEl.innerHTML = phtml;
        }
      })();
    </script>
    <Footer />
  </body>
</html>
