---
// Pagefind search UI component with autohide toggle
// Requires pagefind to be installed and postbuild configured
// Files are generated at build time by postbuild script, not available during build
---

<link href="/pagefind/pagefind-ui.css" rel="stylesheet" is:inline />
<script src="/pagefind/pagefind-ui.js" is:inline></script>

<div class="search-wrapper">
  <button class="search-toggle" id="searchToggle" aria-label="Toggle search">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
  </button>
  <div class="search-dropdown" id="searchDropdown">
    <div id="search"></div>
  </div>
</div>

<script is:inline>
  window.addEventListener('DOMContentLoaded', () => {
    if (typeof PagefindUI !== 'undefined') {
      new PagefindUI({ element: '#search', showImages: false, showSubResults: true });
    }

    const toggle = document.getElementById('searchToggle');
    const dropdown = document.getElementById('searchDropdown');
    const searchWrapper = document.querySelector('.search-wrapper');

    if (toggle && dropdown) {
      toggle.addEventListener('click', (e) => {
        e.stopPropagation();
        dropdown.classList.toggle('open');
        if (dropdown.classList.contains('open')) {
          setTimeout(() => {
            const input = dropdown.querySelector('input');
            if (input) input.focus();
          }, 200);
        }
      });

      document.addEventListener('click', (e) => {
        if (searchWrapper && !searchWrapper.contains(e.target)) {
          dropdown.classList.remove('open');
        }
      });
    }
  });
</script>

<style is:inline>
  .search-wrapper {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    padding: 0 0 0.5em;
    max-width: 1100px;
    margin: 0 auto;
    position: relative;
  }
  .search-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: transparent;
    color: rgb(var(--gray));
    cursor: pointer;
    transition: border-color 0.2s, color 0.2s;
  }
  .search-toggle:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
  .search-dropdown {
    position: absolute;
    top: calc(100% - 4px);
    right: 0;
    width: 340px;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 0.75em;
    box-shadow: 0 8px 24px rgba(0,0,0,0.3);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-6px);
    transition: opacity 0.2s ease, visibility 0.2s ease, transform 0.2s ease;
    z-index: 101;
  }
  .search-dropdown.open {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }
  #search {
    max-width: 100%;
  }
  .pagefind-ui__drawer {
    max-height: 70vh;
    overflow-y: auto;
  }
  .pagefind-ui {
    --pagefind-ui-font: inherit;
  }
  .pagefind-ui__search-input {
    border-radius: 6px;
  }
</style>
