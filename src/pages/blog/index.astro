---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const allTags = [...new Set(posts.flatMap(p => p.data.tags || []))].sort();
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={`Blog — ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Header />
    <main>
      <h1 class="page-title">All Posts</h1>

      {allTags.length > 0 && (
        <div class="tag-cloud" id="tagCloud">
          {allTags.map(tag => (
            <a href={`#tag-${encodeURIComponent(tag)}`} class="tag-pill" data-tag={tag}>{tag}</a>
          ))}
        </div>
      )}

      <div class="filter-bar" id="filterBar">
        <span class="filter-label">Filtering by:</span>
        <span class="filter-tag" id="activeTagDisplay"></span>
        <button class="filter-clear" id="clearFilter">Clear</button>
      </div>

      <div class="post-grid">
        {posts.map((post, i) => (
          <a href={`/blog/${post.id}/`} class="post-card" data-tags={(post.data.tags || []).join(',')} style={`--i: ${i}`}>
            {post.data.heroImage && (
              <img src={post.data.heroImage} alt="" class="card-img" loading="lazy" />
            )}
            <div class="card-body">
              <div class="card-meta">{post.data.pubDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' })}</div>
              <h3>{post.data.title}</h3>
              <p class="card-desc">{post.data.description}</p>
              {post.data.tags && (
                <div class="card-tags">
                  {post.data.tags.slice(0, 3).map(tag => (
                    <span class="card-tag" data-tag={tag}>{tag}</span>
                  ))}
                </div>
              )}
            </div>
          </a>
        ))}
      </div>
    </main>
    <Footer />

    <script>
      function filterByTag(tag) {
        const normalized = tag ? tag.toLowerCase() : '';
        document.querySelectorAll('.post-card').forEach(card => {
          const match = !normalized || (card.dataset.tags || '').toLowerCase().split(',').includes(normalized);
          card.classList.toggle('hidden', !match);
        });
        document.getElementById('filterBar').classList.toggle('active', !!normalized);
        document.getElementById('activeTagDisplay').textContent = tag || '';
        document.querySelectorAll('.tag-pill').forEach(p => {
          p.classList.toggle('active', p.dataset.tag.toLowerCase() === normalized);
        });
        history.replaceState(null, '', normalized ? `#tag-${encodeURIComponent(tag)}` : window.location.pathname);
      }

      const hash = window.location.hash;
      if (hash && hash.startsWith('#tag-')) filterByTag(decodeURIComponent(hash.replace('#tag-', '')));

      document.addEventListener('click', e => {
        const link = e.target.closest('a[href^="#tag-"], span.card-tag');
        if (link) {
          e.preventDefault();
          const tag = link.dataset.tag || decodeURIComponent(link.getAttribute('href').replace('#tag-', ''));
          filterByTag(tag);
        }
      });

      document.getElementById('clearFilter')?.addEventListener('click', () => filterByTag(''));
    </script>
  </body>
</html>
<style>
  .page-title { text-align: center; margin-bottom: 0.5em; font-size: 1.8em; color: #f0f6fc; }
  .tag-cloud { display: flex; flex-wrap: wrap; gap: 0.5em; justify-content: center; margin-bottom: 1.5em; }
  .tag-pill {
    display: inline-block; padding: 0.3em 0.85em; font-size: 0.78em; font-weight: 500;
    color: var(--accent); background: rgba(34,197,94,0.07); border: 1px solid rgba(34,197,94,0.15);
    border-radius: 100px; text-decoration: none; cursor: pointer;
    transition: background 0.2s, border-color 0.2s;
  }
  .tag-pill:hover, .tag-pill.active { background: rgba(34,197,94,0.15); border-color: var(--accent); }
  .filter-bar {
    display: none; align-items: center; justify-content: center; gap: 0.5em;
    margin-bottom: 1em; padding: 0.5em; background: var(--bg-card); border-radius: 8px;
  }
  .filter-bar.active { display: flex; }
  .filter-label { font-size: 0.8em; color: rgb(var(--gray)); }
  .filter-tag { font-size: 0.85em; color: var(--accent); font-weight: 600; }
  .filter-clear {
    background: transparent; border: 1px solid var(--border); color: rgb(var(--gray));
    padding: 0.2em 0.75em; border-radius: 100px; font-size: 0.75em; cursor: pointer;
  }
  .filter-clear:hover { border-color: var(--accent); color: var(--accent); }
  .post-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1.5em;
  }
  .post-card {
    display: flex; flex-direction: column;
    background: var(--bg-card); border: 1px solid var(--border-light);
    border-radius: 14px; overflow: hidden; text-decoration: none;
    transition: transform 0.3s, border-color 0.3s, box-shadow 0.3s;
  }
  .post-card.hidden { display: none; }
  .post-card:hover {
    transform: translateY(-4px); border-color: var(--accent);
    box-shadow: 0 8px 24px rgba(0,0,0,0.25);
  }
  .card-img { width: 100%; aspect-ratio: 16/9; object-fit: cover; border-bottom: 1px solid var(--border-light); }
  .card-body { padding: 1.25em 1.5em 1.5em; flex: 1; }
  .card-meta { font-size: 0.75em; color: rgb(var(--gray)); margin-bottom: 0.3em; }
  .card-body h3 { margin: 0 0 0.4em; font-size: 1.15em; color: #f0f6fc; transition: color 0.2s; }
  .post-card:hover h3 { color: var(--accent); }
  .card-desc {
    font-size: 0.85em; color: rgb(var(--gray)); margin: 0 0 0.75em;
    line-height: 1.5; display: -webkit-box; -webkit-line-clamp: 2;
    -webkit-box-orient: vertical; overflow: hidden;
  }
  .card-tags { display: flex; gap: 0.4em; flex-wrap: wrap; }
  .card-tag {
    font-size: 0.7em; font-weight: 500; color: var(--accent);
    background: rgba(34,197,94,0.06); border: 1px solid rgba(34,197,94,0.12);
    padding: 0.15em 0.55em; border-radius: 100px; cursor: pointer;
    transition: background 0.2s, border-color 0.2s;
  }
  .card-tag:hover { background: rgba(34,197,94,0.12); border-color: var(--accent); }
</style>
