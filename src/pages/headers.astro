---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title="Security Headers Checker — Cybersec AI" description="Check your website's security headers (CSP, HSTS, X-Frame-Options, and more). Free A-F grading with remediation steps. No login required." />
    <style>
      .h-page { width: 100%; max-width: 1100px; margin: 0 auto; padding: 2rem 1.5rem 4rem; }

      /* ── Header ── */
      .h-header { margin-bottom: 2rem; }
      .h-header h1 { margin: 0 0 0.4rem; font-size: clamp(1.6rem, 3vw, 2.2rem); }
      .h-header p { margin: 0; color: rgb(var(--gray, 130,145,170)); font-size: 0.95rem; }

      /* ── Scan card ── */
      .h-card {
        background: var(--bg-card, #161b22);
        border: 1px solid var(--border, #2d3b4e);
        border-radius: 14px;
        padding: 1.5rem;
        margin-bottom: 1.5rem;
        position: relative;
        overflow: hidden;
      }
      .h-card::before {
        content: '';
        position: absolute; top: 0; left: 0; right: 0; height: 2px;
        background: linear-gradient(90deg, transparent, var(--accent, #00d4aa), transparent);
        opacity: 0.6;
      }
      .h-flex { display: flex; gap: 0.5rem; margin-bottom: 0.75rem; flex-wrap: wrap; }
      .h-pill {
        padding: 0.4rem 1.2rem; border: 1px solid var(--border, #2d3b4e); border-radius: 100px;
        background: transparent; color: var(--text-secondary, #94a3b8); cursor: pointer;
        font-size: 0.82rem; font-weight: 500; transition: all 0.2s;
      }
      .h-pill:hover { border-color: var(--accent, #00d4aa); color: var(--accent, #00d4aa); background: rgba(0,212,170,0.06); }
      .h-input-wrap { display: flex; gap: 0.5rem; }
      .h-input-wrap input {
        flex: 1; padding: 0.75rem 1rem;
        border: 1px solid var(--border, #2d3b4e); border-radius: 10px;
        background: rgba(13,17,23,0.6); color: #e8edf4;
        font-size: 0.95rem; outline: none; transition: border-color 0.2s, box-shadow 0.2s;
        box-sizing: border-box;
      }
      .h-input-wrap input:focus {
        border-color: var(--accent, #00d4aa);
        box-shadow: 0 0 0 3px rgba(0,212,170,0.1);
      }
      .h-input-wrap input::placeholder { color: #555; }
      .h-btn {
        padding: 0.75rem 1.75rem; background: var(--accent, #00d4aa); color: #0d1117;
        border: none; border-radius: 10px; font-weight: 600; font-size: 0.9rem;
        cursor: pointer; white-space: nowrap; transition: opacity 0.2s, transform 0.15s;
      }
      .h-btn:hover { opacity: 0.9; transform: translateY(-1px); }
      .h-btn:disabled { opacity: 0.4; cursor: not-allowed; transform: none; }
      .h-err { color: #ef4444; padding: 0.75rem 1rem; background: rgba(239,68,68,.08); border-radius: 8px; margin-bottom: 1rem; border: 1px solid rgba(239,68,68,.15); }
      .spinner { display: inline-block; width: 14px; height: 14px; border: 2px solid rgba(255,255,255,.15); border-top-color: var(--accent); border-radius: 50%; animation: sp .6s linear infinite; vertical-align: middle; margin-right: 5px; }
      @keyframes sp { to { transform: rotate(360deg); } }

      /* ── Result hero card ── */
      .h-result {
        background: var(--bg-card, #161b22);
        border: 1px solid var(--border, #2d3b4e);
        border-radius: 14px; padding: 1.5rem 1.75rem;
        margin-bottom: 1.5rem;
        position: relative;
      }
      .h-result::before {
        content: '';
        position: absolute; top: 0; left: 2rem; right: 2rem; height: 2px;
        background: linear-gradient(90deg, transparent, var(--accent, #00d4aa), transparent);
      }
      .h-result-top { display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
      .h-result-l {
        display: flex; align-items: center; gap: 1rem;
        font-size: 1.15rem; font-weight: 700; color: #e8edf4;
      }
      .h-grade-badge { font-weight: 700; font-size: 1.5rem; }
      .h-result-r { text-align: right; }
      .h-result-verdict { font-size: 0.85rem; color: rgb(var(--gray, 130,145,170)); }
      .h-result-meta { font-size: 0.75rem; color: #555; margin-top: 3px; }
      .h-result-stats { display: flex; gap: 0.4rem; flex-wrap: wrap; margin-top: 0.75rem; padding-top: 0.75rem; border-top: 1px solid var(--border-light, #1e2a3a); }

      /* ── Stat pills ── */
      .h-stat {
        display: inline-flex; align-items: center; gap: 0.3rem;
        padding: 0.2rem 0.6rem; border-radius: 6px;
        font-size: 0.75rem; font-weight: 600;
      }
      .h-green { background: rgba(0,212,170,0.1); color: #00d4aa; }
      .h-red { background: rgba(239,68,68,0.1); color: #ef4444; }
      .h-orange { background: rgba(249,115,22,0.1); color: #f97316; }

      /* ── Grade colors ── */
      .g-a { color: #00d4aa; }
      .g-b { color: #8bc34a; }
      .g-c { color: #eab308; }
      .g-d { color: #f97316; }
      .g-f { color: #ef4444; }

      /* ── Section + table ── */
      .h-section { margin-bottom: 1.5rem; }
      .h-section-title {
        padding: 0.65rem 1rem; font-size: 0.82rem; font-weight: 600;
        background: var(--bg-card, #161b22);
        border: 1px solid var(--border, #2d3b4e);
        border-bottom: none; border-radius: 12px 12px 0 0;
        display: flex; align-items: center; gap: 0.5rem;
        color: #e8edf4;
      }
      .h-section-title .h-count { font-weight: 400; color: #555; font-size: 0.75rem; margin-left: auto; }
      .h-section .h-table-wrap {
        border: 1px solid var(--border, #2d3b4e); border-top: none;
        border-radius: 0 0 12px 12px; overflow: hidden;
      }
      .h-table { width: 100%; border-collapse: collapse; font-size: 0.85rem; }
      .h-table thead th {
        text-align: left; padding: 0.6rem 1rem; font-size: 0.73rem; font-weight: 600;
        text-transform: uppercase; letter-spacing: 0.04em;
        color: #555; background: rgba(255,255,255,0.02);
        border-bottom: 1px solid var(--border-light, #1e2a3a); white-space: nowrap;
      }
      .h-table tbody td { padding: 0.6rem 1rem; border-bottom: 1px solid var(--border-light, #1e2a3a); vertical-align: top; }
      .h-table tbody tr:last-child td { border-bottom: none; }
      .h-table tbody tr { transition: background 0.12s; }
      .h-table tbody tr:hover { background: rgba(0,212,170,0.03); }
      .hd-name { color: #e8edf4; font-weight: 500; font-size: 0.82rem; white-space: nowrap; }
      .hd-ctx { color: #9ca3af; font-size: 0.78rem; line-height: 1.5; }
      .hd-ctx .fix {
        margin-top: 5px; padding: 5px 10px; font-size: 0.76rem;
        background: rgba(0,212,170,.05); border-left: 2px solid var(--accent, #00d4aa);
        border-radius: 4px; color: #b0b0c0;
      }
      .hd-ctx .fix strong { color: var(--accent, #00d4aa); }
      .h-row-fail td { background: rgba(239,68,68,.02); }
      .h-table tr.h-row-fail:hover td { background: rgba(239,68,68,.05); }

      /* ── CTA ── */
      .h-cta {
        margin-top: 2rem; padding: 2rem; text-align: center;
        border: 1px solid var(--border, #2d3b4e); border-radius: 14px;
        background: var(--bg-card, #161b22); position: relative; overflow: hidden;
      }
      .h-cta h3 { margin: 0 0 0.4rem; font-size: 1.1rem; color: #f0f6fc; }
      .h-cta p { color: #6b7280; font-size: 0.85rem; margin: 0 0 1rem; max-width: 450px; margin-left: auto; margin-right: auto; }
      .h-cta a {
        display: inline-block; padding: 0.6rem 1.5rem;
        background: var(--accent, #00d4aa); color: #0d1117;
        border-radius: 10px; font-weight: 600; text-decoration: none; font-size: 0.85rem;
        transition: opacity 0.2s, transform 0.15s;
      }
      .h-cta a:hover { opacity: 0.9; transform: translateY(-1px); }

      /* ── Raw JSON ── */
      .raw-toggle {
        display: inline-block; margin-top: 1rem; padding: 0.4rem 0.8rem;
        background: transparent; border: 1px solid var(--border); border-radius: 8px;
        color: #6b7280; cursor: pointer; font-size: 0.78rem; transition: border-color 0.2s;
      }
      .raw-toggle:hover { border-color: var(--accent); color: var(--accent); }
      .raw-json {
        margin-top: 0.5rem; padding: 1rem;
        background: #0d1117; border-radius: 10px; border: 1px solid var(--border);
        font-family: 'JetBrains Mono', monospace; font-size: 0.75rem;
        white-space: pre-wrap; color: #6b7280;
        display: none;
      }

      /* ── Responsive ── */
      @media (max-width: 640px) {
        .h-result-top { flex-direction: column; align-items: flex-start; }
        .h-flex { flex-direction: column; }
        .h-btn { width: 100%; }
        .h-page { padding: 1rem; }
        .h-input-wrap { flex-direction: column; }
      }
      @media (min-width: 1200px) {
        .h-page { max-width: 1240px; }
      }
      @media (min-width: 1600px) {
        .h-page { max-width: 1440px; padding: 3rem 1.5rem 5rem; }
      }
    </style>
  </head>
  <body>
    <Header />
    <main class="h-page">
      <div class="h-header">
        <h1>Security Headers Checker</h1>
        <p>A–F grade for your site's security headers with remediation steps. No login.</p>
      </div>

      <div class="h-card">
        <div class="h-flex">
          <button class="h-pill" data-d="stripe.com">stripe.com</button>
          <button class="h-pill" data-d="github.com">github.com</button>
          <button class="h-pill" data-d="example.com">example.com</button>
        </div>
        <div class="h-input-wrap">
          <input type="text" id="domain" placeholder="yourdomain.com" spellcheck="false" />
          <button class="h-btn" id="scan-btn">Check Headers</button>
        </div>
      </div>

      <div id="results"></div>

      <script is:inline>
        const domain = document.getElementById('domain');
        const btn = document.getElementById('scan-btn');
        const results = document.getElementById('results');

        function gradeColor(g) {
          return g === 'A' ? '#00d4aa' : g === 'B' ? '#8bc34a' : g === 'C' ? '#eab308' : g === 'D' ? '#f97316' : '#ef4444';
        }
        function gradeDesc(g) {
          return g === 'A' ? 'Excellent' : g === 'B' ? 'Good' : g === 'C' ? 'Fair' : g === 'D' ? 'Poor' : 'Fail';
        }
        function gradeClass(g) { return 'g-' + g.toLowerCase(); }

        btn.addEventListener('click', async () => {
          const d = domain.value.trim().replace(/^https?:\/\//, '').replace(/\/.*$/, '');
          if (!d || !/^[a-zA-Z0-9][a-zA-Z0-9.-]+\.[a-zA-Z]{2,}$/.test(d)) {
            results.innerHTML = '<div class="h-err">Enter a valid domain (e.g. example.com)</div>';
            return;
          }
          btn.disabled = true;
          btn.innerHTML = '<span class="spinner"></span> Checking…';
          results.innerHTML = '';

          try {
            const resp = await fetch('/api/headers?url=' + encodeURIComponent(d));
            if (!resp.ok) {
              const err = await resp.json();
              results.innerHTML = '<div class="h-err">' + (err.error || 'Check failed') + '</div>';
              return;
            }
            const data = await resp.json();
            if (!data.ok) {
              results.innerHTML = '<div class="h-err">' + (data.error || 'Could not reach ' + d) + '</div>';
              return;
            }

            const clr = gradeColor(data.score);
            const desc = gradeDesc(data.score);
            let h = '';

            // ═══ HERO CARD ═══
            h += '<div class="h-result">';
            h += '<div class="h-result-top">';
            h += '<div class="h-result-l">';
            h += '<span>' + data.domain + '</span>';
            h += '<span class="h-grade-badge ' + gradeClass(data.score) + '">' + data.score + '</span>';
            h += '</div>';
            h += '<div class="h-result-r">';
            h += '<div class="h-result-verdict">' + desc + '</div>';
            h += '<div class="h-result-meta">' + data.ms + 'ms · Final: ' + data.finalHost + '</div>';
            h += '</div></div>';
            h += '<div class="h-result-stats">';
            h += '<span class="h-stat h-green">' + data.secureHeaders + '/9 secure headers</span>';
            if (data.infoLeaks > 0) h += '<span class="h-stat h-orange">' + data.infoLeaks + ' info leak' + (data.infoLeaks > 1 ? 's' : '') + '</span>';
            else h += '<span class="h-stat h-green">no leaks</span>';
            h += '</div></div>';

            // ═══ HEADER RESULTS TABLE ═══
            h += '<div class="h-section">';
            h += '<div class="h-section-title">Header Breakdown <span class="h-count">' + Object.keys(data.results).length + ' checks</span></div>';
            h += '<div class="h-table-wrap"><table class="h-table">';
            h += '<thead><tr><th>Header</th><th style="width:50px">Grade</th><th>Detail</th><th>How to Fix</th></tr></thead>';
            h += '<tbody>';

            for (const [key, r] of Object.entries(data.results)) {
              const label = key.replace(/-/g, ' ').replace(/\b\w/g, c => c.toUpperCase());
              const failed = r.grade !== 'A';
              const rcls = failed ? 'h-row-fail' : '';
              const gc = gradeColor(r.grade);
              h += '<tr class="' + rcls + '">';
              h += '<td><div class="hd-name">' + label + '</div></td>';
              h += '<td><span style="font-weight:700;font-size:1rem;color:' + gc + '">' + r.grade + '</span></td>';
              h += '<td class="hd-detail" style="color:#6b7280;font-size:0.8rem">' + r.label + '</td>';
              h += '<td class="hd-ctx">' + (r.remediation ? '<div class="fix"><strong>Fix:</strong> ' + r.remediation + '</div>' : '<span style="color:#6b7280">—</span>') + '</td>';
              h += '</tr>';
            }

            h += '</tbody></table></div></div>';

            // Raw toggle
            h += '<button class="raw-toggle" id="raw-toggle">Show raw JSON</button>';
            h += '<div class="raw-json" id="raw-json">' + JSON.stringify(data, null, 2) + '</div>';

            // ═══ CTA ═══
            h += '<div class="h-cta">';
            h += '<h3>Need a deeper look?</h3>';
            h += '<p>Headers are just the surface. Get a deep security assessment — DNS, email security, CVE correlation, and questionnaire auto-fill.</p>';
            h += '<a href="/scan/">Full Security Assessment →</a>';
            h += '</div>';

            results.innerHTML = h;

            document.getElementById('raw-toggle').addEventListener('click', function() {
              const rj = document.getElementById('raw-json');
              rj.style.display = rj.style.display === 'block' ? 'none' : 'block';
            });

          } catch (e) {
            results.innerHTML = '<div class="h-err">Check failed: ' + e.message + '</div>';
          } finally {
            btn.disabled = false;
            btn.textContent = 'Check Headers';
          }
        });

        document.querySelectorAll('[data-d]').forEach(b => {
          b.addEventListener('click', () => {
            domain.value = b.dataset.d;
            btn.click();
          });
        });

        domain.addEventListener('keydown', e => { if (e.key === 'Enter') btn.click(); });
      </script>
    </main>
    <Footer />
  </body>
</html>
