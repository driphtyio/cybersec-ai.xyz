---
import fixesData from '../../../data/fixes.json';
import BaseHead from '../../../components/BaseHead.astro';
import Footer from '../../../components/Footer.astro';
import Header from '../../../components/Header.astro';

// Helper functions
function buildMap(arr) {
  const m = {};
  for (let i = 0; i < arr.length; i++) {
    const f = arr[i];
    if (!f.fix_desc) f.fix_desc = f.description;
    m[f.id] = f;
  }
  return m;
}

function splitParagraphs(text) {
  if (!text) return [];
  return text.split(String.fromCharCode(10,10)).filter(Boolean).map(function(p) { return p.trim(); });
}

function isBullet(text) {
  return text.startsWith('- ');
}

function extractBulletItems(text) {
  return text.split(String.fromCharCode(10)).filter(Boolean).map(function(l) { return l.trim().replace(/^- /, ''); });
}

function escapeHtml(str) {
  if (!str) return '';
  return str.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
}

// Build data for rendering
const FIX_DATA = buildMap(fixesData);

// getStaticPaths only uses the imported data at module scope
export async function getStaticPaths() {
  const raw = ["PR-scikit-learn-34258", "PR-scikit-learn-34472", "PR-helm-32047", "PR-xarray-11344", "PR-xarray-11373", "PR-cli-1641", "PR-gitleaks-2122", "PR-send-311", "PR-pip-13922", "PR-click-3571", "PR-gitleaks-2121", "PR-send-4944", "PR-TypeScript-25083", "PR-TypeScript-63480", "PR-cookiecutter-2217", "PR-cookiecutter-2219", "PR-requests-6102", "PR-ripgrep-3222", "PR-cookiecutter-uuid-ext-doc", "PR-requests-4965", "PR-click-3360", "PR-psf-requests-6102", "PR-requests-7443"];
  return raw.map((id) => ({ params: { id } }));
}

const { id } = Astro.params;
const fix = FIX_DATA[id];
if (!fix) { return Astro.redirect("/404"); }

const blogUrl = "https://codeintel.xyz/blog/" + fix.filename_stem + "/";
const edgeUrl = fix.edge_key ? "https://codeintel.xyz/blog/" + fix.edge_key + "/" : null;

const paragraphs = splitParagraphs(fix.root_cause);
const patternParas = splitParagraphs(fix.patterns);
---
<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={fix.title + " | PR Bug Fix Database"}
      description={fix.description}
    />
    <style>
      .fix-page { max-width: 900px; margin: 0 auto; padding: 2rem 1.5rem; }
      .fix-header { margin-bottom: 1.5rem; }
      .fix-header h1 { margin: 0 0 0.5rem; font-size: 1.5rem; line-height: 1.3; }
      .fix-meta { display: flex; gap: 0.6rem; flex-wrap: wrap; align-items: center; margin-bottom: 0.5rem; }
      .fix-meta .badge-tag {
        display: inline-block; padding: 0.12rem 0.5rem; border-radius: 3px; font-size: 0.72rem; font-weight: 500;
        background: rgba(0,212,170,0.08); color: var(--ink-muted, #a0a0b0);
      }
      .fix-id { font-family: 'JetBrains Mono', monospace; font-size: 0.85rem; color: var(--accent, #00d4aa); margin-bottom: 0.3rem; }
      .score-display {
        display: inline-flex; align-items: center; gap: 0.4rem;
        padding: 0.35rem 0.8rem; border-radius: 6px; font-weight: 600;
        margin-bottom: 1rem;
      }
      .section { margin-bottom: 1.5rem; }
      .section h2 { font-size: 1.1rem; margin: 0 0 0.8rem; padding-bottom: 0.3rem; border-bottom: 1px solid var(--border, #2d3b4e); }
      .info-grid { display: grid; grid-template-columns: auto 1fr; gap: 0.4rem 1rem; font-size: 0.85rem; margin-bottom: 1rem; }
      .info-grid .label { color: var(--ink-muted, #a0a0b0); font-weight: 500; }
      .info-grid .value { color: #e8edf4; }
      .info-grid a { color: var(--accent, #00d4aa); }
      .root-cause p { color: var(--ink-muted, #a0a0b0); font-size: 0.88rem; line-height: 1.6; margin: 0.4rem 0; }
      .diff-block {
        background: #0d1117; border: 1px solid var(--border, #2d3b4e); border-radius: 6px;
        padding: 1rem; overflow-x: auto; font-size: 0.78rem; line-height: 1.5;
        font-family: 'JetBrains Mono', monospace;
      }
      .diff-block code { color: #e8edf4; white-space: pre; }
      .patterns p { color: var(--ink-muted, #a0a0b0); font-size: 0.88rem; line-height: 1.6; margin: 0.4rem 0; }
      .patterns ul { color: var(--ink-muted, #a0a0b0); font-size: 0.85rem; line-height: 1.5; padding-left: 1.2rem; }
      .patterns li { margin: 0.3rem 0; }
      .blog-link {
        display: inline-block; margin-top: 1rem; padding: 0.5rem 1rem;
        background: rgba(0,212,170,0.08); border: 1px solid rgba(0,212,170,0.2);
        border-radius: 6px; color: var(--accent, #00d4aa); text-decoration: none;
        font-size: 0.85rem;
      }
      .blog-link:hover { background: rgba(0,212,170,0.15); }
      .back-link { display: inline-block; margin-bottom: 1rem; font-size: 0.85rem; color: var(--accent, #00d4aa); text-decoration: none; }
      .back-link:hover { text-decoration: underline; }
      @media (max-width: 720px) {
        .fix-page { padding: 1rem; }
        .info-grid { grid-template-columns: 1fr; }
      }
    </style>
  </head>
  <body>
    <Header />
    <main class="fix-page">
      <a href="/fixes/" class="back-link">&larr; Back to all fixes</a>

      <div class="fix-header">
        <div class="fix-id">{fix.id}</div>
        <h1>{fix.title}</h1>
        <div class="fix-meta">
          <span class="badge-tag">{fix.repo}</span>
          <span class="badge-tag">{fix.pubDate}</span>
          {fix.tags && fix.tags.map((t) => <span class="badge-tag">{t}</span>)}
        </div>
        <div class="score-display" style="background:rgba(0,212,170,0.1)">
          {fix.severity_emoji} Severity: {fix.severity_label} &mdash; Score: {fix.compoundScore}
        </div>
      </div>

      <div class="section">
        <h2>The Bug</h2>
        <div class="info-grid">
          <span class="label">Repo</span>
          <span class="value"><a href={"https://github.com/" + fix.repo} target="_blank" rel="noopener">{fix.repo}</a></span>

          {fix.issue && <>
            <span class="label">Issue</span>
            <span class="value"><a href={"https://github.com/" + fix.repo + "/issues/" + fix.issue} target="_blank" rel="noopener">#{fix.issue}</a></span>
          </>}

          {fix.status && <>
            <span class="label">Status</span>
            <span class="value">{fix.status}</span>
          </>}

          {fix.pr_link && <>
            <span class="label">PR</span>
            <span class="value"><a href={fix.pr_link} target="_blank" rel="noopener">{fix.pr_link}</a></span>
          </>}

          <span class="label">Description</span>
          <span class="value">{fix.fix_desc || fix.description}</span>

          <span class="label">Fix scope</span>
          <span class="value">{fix.fix_scope || 'N/A'}</span>
        </div>
      </div>

      <div class="section">
        <h2>Root Cause</h2>
        <div class="root-cause">
          {paragraphs.map((p) => <p>{p}</p>)}
        </div>
        {edgeUrl && <p><a href={edgeUrl} target="_blank" rel="noopener noreferrer" style="color:var(--accent,#00d4aa)">View the full edge case analysis post &rarr;</a></p>}
      </div>

      <div class="section">
        <h2>The Fix</h2>
        {fix.fix_diff
          ? <pre class="diff-block"><code set:html={escapeHtml(fix.fix_diff)}></code></pre>
          : <p style="color:var(--ink-muted,#a0a0b0)">Diff not available in extracted data.</p>}
      </div>

      <div class="section patterns">
        <h2>Pattern &amp; Takeaways</h2>
        {patternParas.map((p) => {
          if (isBullet(p)) {
            const items = extractBulletItems(p);
            return <ul>{items.map((item) => <li>{item}</li>)}</ul>;
          }
          return <p>{p}</p>;
        })}
      </div>

      <a href={blogUrl} target="_blank" rel="noopener noreferrer" class="blog-link">
        Read the full analysis on codeintel.xyz &rarr;
      </a>
    </main>
    <Footer />
  </body>
</html>
