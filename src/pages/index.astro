---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { getCollection } from 'astro:content';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const allPosts = await getCollection('blog');
allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const latest = allPosts.slice(0, 3);
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Header />
    <main class="lp">
      <!-- Hero -->
      <section class="hero">
        <h1 class="hero-title">
          Know your <span class="hl-red">security posture</span> before your prospects do
        </h1>
        <p class="hero-sub">
          Free domain security scanner, CVE database, and hardening guides — built for SaaS teams closing enterprise deals.
        </p>
        <div class="hero-ctas">
          <a href="/scan/" class="btn btn-primary">Scan your domain →</a>
          <a href="/cves/" class="btn btn-secondary">Browse CVE database</a>
        </div>
      </section>

      <!-- Stats -->
      <section class="stats">
        <div class="stat">
          <span class="stat-num">500+</span>
          <span class="stat-label">Critical CVEs indexed</span>
        </div>
        <div class="stat">
          <span class="stat-num">2</span>
          <span class="stat-label">Security guides</span>
        </div>
        <div class="stat">
          <span class="stat-num">Free</span>
          <span class="stat-label">No login required</span>
        </div>
        <div class="stat">
          <span class="stat-num">NVD</span>
          <span class="stat-label">Official source data</span>
        </div>
      </section>

      <!-- Products -->
      <section class="products">
        <h2 class="section-title">What you get</h2>
        <div class="product-grid">
          <a href="/scan/" class="product-card">
            <div class="product-icon">🔍</div>
            <h3>Domain Security Scanner</h3>
            <p>Check your domain against the same things enterprise security teams audit: DNS, SSL, HTTP headers, DMARC, and more. Free, no login, 10 seconds.</p>
            <span class="product-cta">Check your domain →</span>
          </a>
          <a href="/cves/" class="product-card">
            <div class="product-icon">🛡️</div>
            <h3>CVE Vulnerability Database</h3>
            <p>Search and browse 500+ critical CVEs indexed from the National Vulnerability Database. Filter by severity, keyword, and vendor.</p>
            <span class="product-cta">Browse CVEs →</span>
          </a>
          <a href="/blog/" class="product-card">
            <div class="product-icon">📘</div>
            <h3>Security Guides & Research</h3>
            <p>Practical hardening guides, threat analysis, and security posture best practices for SaaS teams — based on real production experience.</p>
            <span class="product-cta">Read guides →</span>
          </a>
        </div>
      </section>

      <!-- Blog feed -->
      <section class="blog-feed">
        <h2 class="section-title">Latest guides</h2>
        <div class="post-grid">
          {latest.map((post, i) => (
            <a href={`/blog/${post.id}/`} class="post-card" style={`--i: ${i}`}>
              {post.data.heroImage && (
                <img src={post.data.heroImage} alt="" class="card-img" loading="lazy" />
              )}
              <div class="card-body">
                <div class="card-meta">{post.data.pubDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</div>
                <h3>{post.data.title}</h3>
                <p class="card-desc">{post.data.description}</p>
                {post.data.tags && (
                  <div class="card-tags">
                    {post.data.tags.slice(0, 3).map(tag => (
                      <span class="card-tag">{tag}</span>
                    ))}
                  </div>
                )}
              </div>
            </a>
          ))}
        </div>
        <div class="view-all">
          <a href="/blog/" class="btn btn-secondary">View all posts</a>
        </div>
      </section>

      <!-- CTA -->
      <section class="cta-section">
        <h2>Close your next deal faster</h2>
        <p>Know your security posture. Fix what's broken. Walk into enterprise negotiations with proof, not promises.</p>
        <a href="/scan/" class="btn btn-primary btn-lg">Scan your domain — it's free →</a>
      </section>
    </main>
    <Footer />
  </body>
</html>

<style is:global>
  /* Layout */
  .lp { width: 100%; max-width: 1100px; margin: 0 auto; padding: 0 1.5em 4em; }
  section { margin: 5em 0; }
  .section-title {
    font-size: 1.6em; font-weight: 700; text-align: center;
    margin: 0 0 2em; color: #f0f6fc;
  }

  /* Buttons */
  .btn {
    display: inline-block; padding: 0.7em 1.6em; border-radius: 8px;
    font-size: 0.9em; font-weight: 600; text-decoration: none;
    transition: all 0.2s; cursor: pointer;
  }
  .btn-primary {
    background: var(--accent); color: #0a0e14; border: 1px solid var(--accent);
  }
  .btn-primary:hover { background: var(--accent-dark); border-color: var(--accent-dark); }
  .btn-secondary {
    background: transparent; color: #e8edf4; border: 1px solid var(--border);
  }
  .btn-secondary:hover { border-color: var(--accent); color: var(--accent); }
  .btn-lg { padding: 0.9em 2em; font-size: 1em; }

  /* Hero */
  .hero { text-align: center; padding: 4em 0 1em; }
  .hero-title {
    font-size: clamp(1.8em, 5vw, 2.8em); font-weight: 700;
    margin: 0 auto 0.5em; line-height: 1.2;
    color: #f0f6fc; max-width: 800px;
  }
  .hl-red { color: var(--accent); }
  .hero-sub {
    color: rgb(var(--gray)); font-size: 1.05em; line-height: 1.5;
    max-width: 600px; margin: 0 auto 1.8em;
  }
  .hero-ctas { display: flex; gap: 0.8em; justify-content: center; flex-wrap: wrap; }

  /* Stats */
  .stats {
    display: grid; grid-template-columns: repeat(4, 1fr); gap: 1em;
    padding: 2em 0; max-width: 800px; margin: 0 auto;
  }
  .stat {
    text-align: center; padding: 1.2em 0.5em;
    border: 1px solid var(--border-light); border-radius: 10px;
    background: var(--bg-card);
  }
  .stat-num {
    display: block; font-size: 1.6em; font-weight: 700;
    color: var(--accent); margin-bottom: 0.2em;
  }
  .stat-label { font-size: 0.78em; color: rgb(var(--gray)); line-height: 1.3; }

  /* Products */
  .product-grid {
    display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.2em;
  }
  .product-card {
    display: block; padding: 1.8em 1.5em;
    border: 1px solid var(--border-light); border-radius: 14px;
    background: var(--bg-card); text-decoration: none;
    transition: transform 0.25s, border-color 0.25s, box-shadow 0.25s;
  }
  .product-card:hover {
    transform: translateY(-4px); border-color: var(--accent);
    box-shadow: 0 8px 24px rgba(0,0,0,0.25);
  }
  .product-icon { font-size: 2em; margin-bottom: 0.3em; }
  .product-card h3 { margin: 0 0 0.6em; font-size: 1.15em; color: #f0f6fc; }
  .product-card p {
    margin: 0 0 1em; font-size: 0.85em; color: rgb(var(--gray));
    line-height: 1.55;
  }
  .product-cta { font-size: 0.85em; font-weight: 600; color: var(--accent); }

  /* Blog feed */
  .post-grid {
    display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.2em;
  }
  .post-card {
    display: flex; flex-direction: column;
    border: 1px solid var(--border-light); border-radius: 14px;
    background: var(--bg-card); text-decoration: none; overflow: hidden;
    transition: transform 0.25s, border-color 0.25s;
  }
  .post-card:hover {
    transform: translateY(-4px); border-color: var(--accent);
  }
  .card-img { width: 100%; aspect-ratio: 16/9; object-fit: cover; border-bottom: 1px solid var(--border-light); }
  .card-body { padding: 1.25em 1.5em 1.5em; flex: 1; display: flex; flex-direction: column; }
  .card-meta { font-size: 0.75em; color: rgb(var(--gray)); margin-bottom: 0.3em; }
  .card-body h3 { margin: 0 0 0.4em; font-size: 1.05em; color: #f0f6fc; flex: 1; }
  .post-card:hover h3 { color: var(--accent); }
  .card-desc {
    font-size: 0.82em; color: rgb(var(--gray)); margin: 0 0 0.6em;
    line-height: 1.5; display: -webkit-box; -webkit-line-clamp: 2;
    -webkit-box-orient: vertical; overflow: hidden;
  }
  .card-tags { display: flex; gap: 0.4em; flex-wrap: wrap; }
  .card-tag {
    font-size: 0.68em; font-weight: 500; color: var(--accent);
    background: rgba(0,212,170,0.06); border: 1px solid rgba(0,212,170,0.12);
    padding: 0.15em 0.5em; border-radius: 100px;
  }
  .view-all { text-align: center; margin-top: 1.5em; }

  /* CTA section */
  .cta-section {
    text-align: center; padding: 3.5em 2em;
    border: 1px solid var(--border); border-radius: 18px;
    background: linear-gradient(135deg, var(--bg-card) 0%, #0d1117 100%);
  }
  .cta-section h2 { margin: 0 0 0.5em; font-size: 1.5em; }
  .cta-section p { color: rgb(var(--gray)); max-width: 500px; margin: 0 auto 1.5em; font-size: 0.9em; }

  /* Responsive */
  @media (max-width: 768px) {
    .stats { grid-template-columns: repeat(2, 1fr); }
    .product-grid { grid-template-columns: 1fr; }
    .steps { flex-direction: column; align-items: stretch; }
    .step-arrow { display: none; }
    .post-grid { grid-template-columns: 1fr; }
  }
</style>
